---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TermCard from '../components/TermCard.astro';
import TermQuiz from '../components/TermQuiz.astro';

const modules = [
	'칩 하나 만들어 보기',
	'기초 원리',
	'제품과 산업',
	'팹과 클린룸',
	'전공정',
	'계측·검사·수율',
	'후공정',
	'최신 기술',
	'현장 소통',
];

const terms = (await getCollection('glossary')).sort((a, b) => a.data.ko.localeCompare(b.data.ko, 'ko'));

const counts = modules.map((_, i) => terms.filter((t) => String(t.data.module) === String(i)).length);

const searchText = (t: (typeof terms)[number]['data']) =>
	[t.ko, t.en, t.ja, t.ja_reading, t.zh_cn, t.zh_cn_pinyin, t.zh_tw, t.zh_tw_pinyin, t.abbr, t.field_usage, t.definition_ko]
		.filter(Boolean)
		.join(' ')
		.toLowerCase();
// TermCard와 같은 규칙: 약어로 부르는 용어는 약어를 표제어로 쓴다.
const headAbbrOf = (t: (typeof terms)[number]['data']) =>
	(t.abbr
		? String(t.abbr)
				.split(',')
				.map((s) => s.trim())
				.filter(Boolean)
		: []
	).find((a) => /^[A-Z][A-Za-z0-9]{2,}$/.test(a) && (a.match(/[A-Z]/g) ?? []).length >= 2);
---

<Base title="용어집">
	<nav slot="sidebar" class="stage-picker" aria-label="단계로 고르기">
		<p class="picker-title">단계로 고르기</p>
		<ul>
			<li>
				<button type="button" data-stage="" aria-pressed="true">
					<span>전체</span>
					<span class="n">{terms.length}</span>
				</button>
			</li>
			{
				modules.map((name, i) => (
					<li>
						<button type="button" data-stage={i} aria-pressed="false">
							<span class="stage-num">{i}</span>
							<span>{name}</span>
							<span class="n">{counts[i]}</span>
						</button>
					</li>
				))
			}
		</ul>
	</nav>

	<h1>용어집</h1>

	<nav class="views" aria-label="보기 전환">
		<a href="#" data-view-link="list" aria-current="page">용어 목록</a>
		<a href="#quiz" data-view-link="quiz">용어 맞히기</a>
	</nav>

	<div data-view="list">
	<form class="search" role="search" data-glossary-search>
		<label>
			<span>검색</span>
			<input type="search" placeholder="용어, 약어, 현장 표현 검색" autocomplete="off" data-search />
		</label>
	</form>

	<p class="count" aria-live="polite"><span data-count>{terms.length}</span>개 용어 · 가나다순</p>

	<ul class="terms">
		{
			terms.map((term) => (
				<li data-term data-term-module={term.data.module} data-term-search={searchText(term.data)}>
					<details class="term">
						<summary class="row">
							<span class="row-ko">
								{headAbbrOf(term.data) ?? term.data.ko}
								{headAbbrOf(term.data) && <span class="row-sub">{term.data.ko}</span>}
							</span>
							<span class="row-foreign">
								{term.data.en && <span data-lang="en" lang="en">{term.data.en}</span>}
								{term.data.ja && <span data-lang="ja" lang="ja">{term.data.ja}</span>}
								{term.data.zh_cn && <span data-lang="zh-Hans" lang="zh-Hans">{term.data.zh_cn}</span>}
								{term.data.zh_tw && <span data-lang="zh-Hant" lang="zh-Hant">{term.data.zh_tw}</span>}
							</span>
							{!term.data.verified && <span class="badge unverified">확인 전</span>}
							<span class="badge">{term.data.module}단계</span>
						</summary>
						<div class="term-body">
							<TermCard id={term.id} glossaryLink={false} />
							{term.data.sources && term.data.sources.length > 0 && (
								<p class="sources">
									출처:{' '}
									{term.data.sources.map((url: string, i: number) => (
										<>
											{i > 0 && ', '}
											<a href={url} target="_blank" rel="noopener noreferrer">
												{new URL(url).hostname.replace(/^www\./, '')}
											</a>
										</>
									))}
								</p>
							)}
						</div>
					</details>
				</li>
			))
		}
	</ul>
	<p class="empty" hidden data-empty>조건에 맞는 용어가 없습니다.</p>
		</div>

	<div data-view="quiz" hidden>
		<TermQuiz modules={modules} />
	</div>
</Base>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-glossary-search]')!;
	const search = form.querySelector<HTMLInputElement>('[data-search]')!;
	const stageButtons = document.querySelectorAll<HTMLButtonElement>('[data-stage]');
	const items = document.querySelectorAll<HTMLElement>('[data-term]');
	const count = document.querySelector<HTMLElement>('[data-count]')!;
	const empty = document.querySelector<HTMLElement>('[data-empty]')!;

	let stage = '';

	const apply = () => {
		const words = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
		let shown = 0;

		items.forEach((item) => {
			const text = item.dataset.termSearch!;
			const match =
				(stage === '' || item.dataset.termModule === stage) && words.every((word) => text.includes(word));
			item.hidden = !match;
			if (match) shown++;
		});

		count.textContent = String(shown);
		empty.hidden = shown > 0;
	};

	form.addEventListener('submit', (event) => event.preventDefault());
	search.addEventListener('input', apply);

	stageButtons.forEach((button) => {
		button.addEventListener('click', () => {
			stage = button.dataset.stage ?? '';
			stageButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
			apply();
		});
	});

	// #term-{id} 해시로 들어오면 필터를 풀고, 그 항목을 펼쳐서 보여 준다.
	const views = document.querySelectorAll<HTMLElement>('[data-view]');
	const viewLinks = document.querySelectorAll<HTMLElement>('[data-view-link]');
	const showView = () => {
		const name = window.location.hash === '#quiz' ? 'quiz' : 'list';
		views.forEach((v) => (v.hidden = v.dataset.view !== name));
		viewLinks.forEach((a) => {
			if (a.dataset.viewLink === name) a.setAttribute('aria-current', 'page');
			else a.removeAttribute('aria-current');
		});
	};

	const openFromHash = () => {
		showView();
		const hash = window.location.hash;
		if (!hash.startsWith('#term-')) return;
		const target = document.getElementById(decodeURIComponent(hash.slice(1)));
		const item = target?.closest<HTMLElement>('[data-term]');
		if (!target || !item) return;

		if (item.hidden) {
			stage = '';
			search.value = '';
			stageButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.stage === '')));
			apply();
		}
		const details = item.querySelector<HTMLDetailsElement>('details.term');
		if (details) details.open = true;
		item.scrollIntoView({ block: 'start' });
	};

	apply();
	openFromHash();
	window.addEventListener('hashchange', openFromHash);
</script>

<style>
	.search label {
		display: grid;
		gap: var(--space-1);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		color: var(--text-muted);
	}

	input {
		width: 100%;
		min-height: var(--touch-min);
		padding: 0 var(--space-3);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: var(--fs-body);
	}

	.views {
		display: flex;
		gap: var(--space-2);
		margin: 0 0 var(--space-4);
	}

	.views a {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-min);
		padding: 0 var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		color: var(--text);
		text-decoration: none;
	}

	.views a[aria-current='page'] {
		border-color: var(--primary);
		font-weight: 700;
	}

	.sources {
		margin: var(--space-3) 0 0;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		color: var(--text-muted);
	}

	.count {
		margin: var(--space-3) 0;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		color: var(--text-muted);
	}

	.terms {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.terms > li {
		min-width: 0;
	}

	/* 펼친 행 안의 카드는 행이 이미 테두리와 표제를 가지므로 겹치지 않게 한다 */
	.term-body :global(.term-card) {
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
	}

	.term-body :global(.term-card .ko),
	.term-body :global(.term-card .chip.caption) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.term {
		min-width: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
	}

	.term[open] {
		border-color: var(--primary);
	}

	.row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: 56px;
		padding: 0 var(--space-4);
		cursor: pointer;
		list-style: none;
	}

	.row::-webkit-details-marker {
		display: none;
	}

	.row:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
		border-radius: var(--radius-lg);
	}

	.row-ko {
		flex: none;
		font-size: var(--fs-body);
		line-height: var(--lh-body);
		font-weight: 700;
	}

	.row-foreign {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 500;
		color: var(--text-muted);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.row-foreign > span {
		margin-inline-end: var(--space-3);
	}

	.row-sub {
		margin-inline-start: var(--space-2);
		font-size: var(--fs-small);
		font-weight: 500;
		color: var(--text-muted);
	}

	.badge.unverified {
		color: var(--text-muted);
	}

	.badge {
		flex: none;
		padding: 0 var(--space-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		line-height: var(--lh-caption);
		font-weight: 500;
		color: var(--accent);
	}

	.term-body {
		padding: 0 var(--space-4) var(--space-4);
	}

	.empty {
		color: var(--text-muted);
	}

	.stage-picker {
		display: block;
	}

	.picker-title {
		margin: 0 0 var(--space-2);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
		color: var(--text-muted);
	}

	.stage-picker ul {
		display: grid;
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stage-picker button {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		width: 100%;
		min-height: var(--touch-min);
		padding: 0 var(--space-3);
		border: 0;
		border-radius: var(--radius-md);
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		text-align: left;
		cursor: pointer;
	}

	.stage-picker button[aria-pressed='true'] {
		background: var(--primary-soft);
		color: var(--primary);
		font-weight: 600;
	}

	.stage-picker .stage-num {
		font-family: var(--font-mono);
		color: var(--accent);
	}

	.stage-picker .n {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		color: var(--text-muted);
	}

	.stage-picker button:focus-visible,
	input:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}
</style>
