---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TermCard from '../components/TermCard.astro';
import TermQuiz from '../components/TermQuiz.astro';
import { audioPath } from '../scripts/audio-path';

const modules = [
	'칩 하나 만들어 보기',
	'기초 원리',
	'제품과 산업',
	'팹과 클린룸',
	'전공정',
	'계측·검사·수율',
	'후공정',
	'최신 기술',
	'현장 소통',
];

const terms = (await getCollection('glossary')).sort((a, b) => a.data.ko.localeCompare(b.data.ko, 'ko'));

const counts = modules.map((_, i) => terms.filter((t) => String(t.data.module) === String(i)).length);

const searchText = (t: (typeof terms)[number]['data']) =>
	[t.ko, t.en, t.ja, t.ja_reading, t.zh_cn, t.zh_cn_pinyin, t.zh_tw, t.zh_tw_pinyin, t.abbr, t.field_usage, t.definition_ko]
		.filter(Boolean)
		.join(' ')
		.toLowerCase();
// TermCard와 같은 규칙: 약어로 부르는 용어는 약어를 표제어로 쓴다.
const headAbbrOf = (t: (typeof terms)[number]['data']) =>
	(t.abbr
		? String(t.abbr)
				.split(',')
				.map((s) => s.trim())
				.filter(Boolean)
		: []
	).find((a) => /^[A-Z][A-Za-z0-9]{2,}$/.test(a) && (a.match(/[A-Z]/g) ?? []).length >= 2);

// 접힌 줄 발음 버튼: 언어마다 하나씩 그리고, 고른 언어(첫 번째)의 것만 CSS로 보인다.
const foldSpeak = (id: string, t: (typeof terms)[number]['data']) =>
	[
		{ lang: 'en', name: 'English', speak: 'en-US', key: 'en', text: t.en },
		{ lang: 'ja', name: '日本語', speak: 'ja-JP', key: 'ja', text: t.ja },
		{ lang: 'zh-Hans', name: '简体中文', speak: 'zh-CN', key: 'zh_cn', text: t.zh_cn },
		{ lang: 'zh-Hant', name: '繁體中文', speak: 'zh-TW', key: 'zh_tw', text: t.zh_tw },
	]
		.filter((r) => r.text)
		.map((r) => ({ ...r, audio: audioPath('terms', id, r.key) }));
---

<Base title="용어집">
	<nav slot="sidebar" class="stage-picker" aria-label="단계로 고르기">
		<p class="picker-title">단계로 고르기</p>
		<ul>
			<li>
				<button type="button" data-stage="" aria-pressed="true">
					<span>전체</span>
					<span class="n">{terms.length}</span>
				</button>
			</li>
			{
				modules.map((name, i) => counts[i] > 0 && (
					<li>
						<button type="button" data-stage={i} aria-pressed="false">
							<span class="stage-num">{i}</span>
							<span>{name}</span>
							<span class="n">{counts[i]}</span>
						</button>
					</li>
				))
			}
		</ul>
	</nav>

	<h1>용어집</h1>

	<nav class="views" aria-label="보기 전환">
		<a href="#" data-view-link="list" aria-current="page">용어 목록</a>
		<a href="#quiz" data-view-link="quiz">용어 맞히기</a>
	</nav>

	<div data-view="list">
	<form class="search" role="search" data-glossary-search>
		<label>
			<span>검색</span>
			<input type="search" placeholder="용어, 약어, 현장 표현 검색" autocomplete="off" data-search />
		</label>
	</form>

	<div class="saved-tools">
			<label class="stage-select">
					<span>단계</span>
					<select data-stage-select>
						<option value="">전체 ({terms.length})</option>
						{modules.map((name, i) => counts[i] > 0 && <option value={String(i)}>{i}. {name} ({counts[i]})</option>)}
					</select>
				</label>
				<button type="button" class="saved-toggle" aria-pressed="false" data-saved-toggle>저장한 용어</button>
				<button type="button" class="saved-toggle" aria-pressed="false" data-sort-toggle>단계순</button>
		</div>

		<p class="count" aria-live="polite"><span data-count>{terms.length}</span>개 용어 · <span data-sort-label>가나다순</span></p>

	<ul class="terms">
		{
			terms.map((term) => (
				<li data-term data-term-id={term.id} data-term-module={term.data.module} data-term-search={searchText(term.data)}>
					<details class="term">
						<summary class="row">
							<span class="row-ko">
								{headAbbrOf(term.data) ?? term.data.ko}
								{headAbbrOf(term.data) && <span class="row-sub">{term.data.ko}</span>}
							</span>
							<span class="row-foreign">
								{term.data.en && <span data-lang="en" lang="en">{term.data.en}</span>}
								{term.data.ja && <span data-lang="ja" lang="ja">{term.data.ja}</span>}
								{term.data.zh_cn && <span data-lang="zh-Hans" lang="zh-Hans">{term.data.zh_cn}</span>}
								{term.data.zh_tw && <span data-lang="zh-Hant" lang="zh-Hant">{term.data.zh_tw}</span>}
							</span>
							{foldSpeak(term.id, term.data).map((r) => (
								<span class="fold-speak" data-fold-lang={r.lang}>
									<button
										class="speak"
										type="button"
										aria-label={`${r.name} 발음 듣기`}
										data-speak={r.text}
										data-speak-lang={r.speak}
										data-audio={r.audio}
									>
										<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
											<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
											<path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
										</svg>
									</button>
								</span>
							))}
							{!term.data.verified && <span class="badge unverified">확인 전</span>}
							<span class="badge">{term.data.module}단계</span>
						</summary>
						<div class="term-body">
							<TermCard id={term.id} glossaryLink={false} />
							{term.data.sources && term.data.sources.length > 0 && (
								<p class="sources">
									출처:{' '}
									{term.data.sources.map((url: string, i: number) => (
										<>
											{i > 0 && ', '}
											<a href={url} target="_blank" rel="noopener noreferrer">
												{new URL(url).hostname.replace(/^www\./, '')}
											</a>
										</>
									))}
								</p>
							)}
						</div>
					</details>
				</li>
			))
		}
	</ul>
	<p class="empty" hidden data-empty>조건에 맞는 용어가 없습니다.</p>
		</div>

	<div data-view="quiz" hidden>
		<TermQuiz modules={modules} />
	</div>
</Base>

<script>
	const form = document.querySelector<HTMLFormElement>('[data-glossary-search]')!;
	const search = form.querySelector<HTMLInputElement>('[data-search]')!;
	const stageButtons = document.querySelectorAll<HTMLButtonElement>('[data-stage]');
	const items = document.querySelectorAll<HTMLElement>('[data-term]');
	const count = document.querySelector<HTMLElement>('[data-count]')!;
	const empty = document.querySelector<HTMLElement>('[data-empty]')!;

	const savedToggle = document.querySelector<HTMLButtonElement>('[data-saved-toggle]')!;
		const SAVED_TERMS_KEY = 'sc-saved-terms';
		const readSaved = () => {
			try {
				const v: unknown = JSON.parse(localStorage.getItem(SAVED_TERMS_KEY) ?? '[]');
				return new Set(Array.isArray(v) ? v.filter((x): x is string => typeof x === 'string') : []);
			} catch {
				return new Set<string>();
			}
		};

		let stage = '';

	const stageSelect = document.querySelector<HTMLSelectElement>('[data-stage-select]')!;
	const sortToggle = document.querySelector<HTMLButtonElement>('[data-sort-toggle]')!;
	const sortLabel = document.querySelector<HTMLElement>('[data-sort-label]')!;
	const list = document.querySelector<HTMLElement>('ul.terms')!;
	// 가나다순은 처음 그려진 순서다. 단계순은 단계 번호, 같은 단계 안에서는 가나다순.
	const original = Array.from(items);
	const sortItems = () => {
		const byStage = sortToggle.getAttribute('aria-pressed') === 'true';
		const ordered = byStage
			? [...original].sort(
					(a, b) =>
						Number(a.dataset.termModule) - Number(b.dataset.termModule) || original.indexOf(a) - original.indexOf(b),
				)
			: original;
		ordered.forEach((li) => list.appendChild(li));
		sortLabel.textContent = byStage ? '단계순' : '가나다순';
	};
	const setStage = (value: string) => {
		stage = value;
		stageButtons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.stage ?? '') === value)));
		stageSelect.value = value;
		apply();
	};

	const apply = () => {
		const words = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
		let shown = 0;

		items.forEach((item) => {
			const text = item.dataset.termSearch!;
			const match =
				(stage === '' || item.dataset.termModule === stage) &&
					(savedToggle.getAttribute('aria-pressed') !== 'true' || readSaved().has(item.dataset.termId ?? '')) &&
					words.every((word) => text.includes(word));
			item.hidden = !match;
			if (match) shown++;
		});

		count.textContent = String(shown);
		empty.hidden = shown > 0;
	};

	form.addEventListener('submit', (event) => event.preventDefault());
	search.addEventListener('input', apply);

		savedToggle.addEventListener('click', () => {
			savedToggle.setAttribute('aria-pressed', String(savedToggle.getAttribute('aria-pressed') !== 'true'));
			apply();
		});

	stageButtons.forEach((button) => {
		button.addEventListener('click', () => setStage(button.dataset.stage ?? ''));
	});
	stageSelect.addEventListener('change', () => setStage(stageSelect.value));
	sortToggle.addEventListener('click', () => {
		sortToggle.setAttribute('aria-pressed', String(sortToggle.getAttribute('aria-pressed') !== 'true'));
		sortItems();
	});

	// #term-{id} 해시로 들어오면 필터를 풀고, 그 항목을 펼쳐서 보여 준다.
	const views = document.querySelectorAll<HTMLElement>('[data-view]');
	const viewLinks = document.querySelectorAll<HTMLElement>('[data-view-link]');
	const showView = () => {
		const name = window.location.hash === '#quiz' ? 'quiz' : 'list';
		views.forEach((v) => (v.hidden = v.dataset.view !== name));
		viewLinks.forEach((a) => {
			if (a.dataset.viewLink === name) a.setAttribute('aria-current', 'page');
			else a.removeAttribute('aria-current');
		});
	};

	const openFromHash = () => {
		showView();
		const hash = window.location.hash;
		if (!hash.startsWith('#term-')) return;
		const target = document.getElementById(decodeURIComponent(hash.slice(1)));
		const item = target?.closest<HTMLElement>('[data-term]');
		if (!target || !item) return;

		if (item.hidden) {
			stage = '';
			search.value = '';
				savedToggle.setAttribute('aria-pressed', 'false');
			setStage('');
		}
		const details = item.querySelector<HTMLDetailsElement>('details.term');
		if (details) details.open = true;
		item.scrollIntoView({ block: 'start' });
	};

	apply();
	openFromHash();
	window.addEventListener('hashchange', openFromHash);
</script>

<style>
	.search label {
		display: grid;
		gap: var(--space-1);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		color: var(--text-muted);
	}

	input {
		width: 100%;
		min-height: var(--touch-min);
		padding: 0 var(--space-3);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: var(--fs-body);
	}

	.views {
		display: flex;
		gap: var(--space-2);
		margin: 0 0 var(--space-4);
	}

	.views a {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-min);
		padding: 0 var(--space-4);
		border: 1px solid var(--border);
		border-radius: var(--radius-md);
		color: var(--text);
		text-decoration: none;
	}

	.views a[aria-current='page'] {
		border-color: var(--primary);
		font-weight: 700;
	}

	.sources {
		margin: var(--space-3) 0 0;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		color: var(--text-muted);
	}

	.saved-tools {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-3);
	}

	/* 휴대폰·태블릿에서는 단계 목록이 서랍 안에 있으므로 목록 위에서도 단계를 고르게 한다 */
	.stage-select {
		display: none;
		flex: 1 1 100%;
		min-width: 0;
		gap: var(--space-1);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		color: var(--text-muted);
	}

	.stage-select select {
		width: 100%;
		min-height: var(--touch-min);
		padding: 0 var(--space-3);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: 16px;
	}

	.stage-select select:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	@media (max-width: 959px) {
		.stage-select {
			display: grid;
		}
	}

	.fold-speak {
		display: none;
		flex: none;
	}

	.fold-speak :global(.speak) {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--touch-min);
		height: var(--touch-min);
		padding: 0;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-full);
		background: var(--surface);
		color: var(--primary);
		cursor: pointer;
	}

	.fold-speak :global(.speak[hidden]),
	.fold-speak :global(.speak-unavailable) {
		display: none;
	}

	:global(html[data-first-lang='en']) .fold-speak[data-fold-lang='en'],
	:global(html[data-first-lang='ja']) .fold-speak[data-fold-lang='ja'],
	:global(html[data-first-lang='zh-Hans']) .fold-speak[data-fold-lang='zh-Hans'],
	:global(html[data-first-lang='zh-Hant']) .fold-speak[data-fold-lang='zh-Hant'] {
		display: block;
	}

	.saved-toggle {
		min-height: var(--touch-min);
		max-width: 100%;
		padding: 0 var(--space-3);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
		cursor: pointer;
	}

	.saved-toggle[aria-pressed='true'] {
		border-color: var(--primary);
		background: var(--primary-soft);
		color: var(--primary);
	}

	.saved-toggle:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.count {
		margin: var(--space-3) 0;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		color: var(--text-muted);
	}

	.terms {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.terms > li {
		min-width: 0;
	}

	/* 펼친 행 안의 카드는 행이 이미 테두리와 표제를 가지므로 겹치지 않게 한다 */
	.term-body :global(.term-card) {
		margin: 0;
		padding: 0;
		border: 0;
		background: none;
	}

	.term-body :global(.term-card .ko),
	.term-body :global(.term-card .chip.caption) {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.term {
		min-width: 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
	}

	.term[open] {
		border-color: var(--primary);
	}

	.row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: 56px;
		padding: 0 var(--space-4);
		cursor: pointer;
		list-style: none;
	}

	.row::-webkit-details-marker {
		display: none;
	}

	.row:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
		border-radius: var(--radius-lg);
	}

	.row-ko {
		flex: none;
		font-size: var(--fs-body);
		line-height: var(--lh-body);
		font-weight: 700;
	}

	.row-foreign {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 500;
		color: var(--text-muted);
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.row-foreign > span {
		margin-inline-end: var(--space-3);
	}

	.row-sub {
		margin-inline-start: var(--space-2);
		font-size: var(--fs-small);
		font-weight: 500;
		color: var(--text-muted);
	}

	.badge.unverified {
		color: var(--text-muted);
	}

	.badge {
		flex: none;
		padding: 0 var(--space-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		line-height: var(--lh-caption);
		font-weight: 500;
		color: var(--accent);
	}

	.term-body {
		padding: 0 var(--space-4) var(--space-4);
	}

	.empty {
		color: var(--text-muted);
	}

	.stage-picker {
		display: block;
	}

	.picker-title {
		margin: 0 0 var(--space-2);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
		color: var(--text-muted);
	}

	.stage-picker ul {
		display: grid;
		gap: 2px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stage-picker button {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		width: 100%;
		min-height: var(--touch-min);
		padding: 0 var(--space-3);
		border: 0;
		border-radius: var(--radius-md);
		background: transparent;
		color: var(--text);
		font: inherit;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		text-align: left;
		cursor: pointer;
	}

	.stage-picker button[aria-pressed='true'] {
		background: var(--primary-soft);
		color: var(--primary);
		font-weight: 600;
	}

	.stage-picker .stage-num {
		font-family: var(--font-mono);
		color: var(--accent);
	}

	.stage-picker .n {
		margin-left: auto;
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		color: var(--text-muted);
	}

	.stage-picker button:focus-visible,
	input:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}
</style>
