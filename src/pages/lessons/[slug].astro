---
import Lesson from '../../layouts/Lesson.astro';
import LessonComplete from '../../components/LessonComplete.astro';

export function getStaticPaths() {
	const modules = import.meta.glob('../../content/lessons/*.mdx', { eager: true }) as Record<string, any>;

	const entries = Object.entries(modules)
		.map(([path, mod]) => ({
			slug: path.split('/').pop()!.replace(/\.mdx$/, ''),
			title: String(mod.frontmatter.title ?? ''),
			module: Number(mod.frontmatter.module ?? 0),
			order: Number(mod.frontmatter.order ?? 0),
			summary: String(mod.frontmatter.summary ?? ''),
			Content: mod.Content,
		}))
		.sort((a, b) => a.module - b.module || a.order - b.order || a.slug.localeCompare(b.slug));

	const meta = entries.map(({ Content, ...m }) => m);

	return entries.map((e, i) => ({
		params: { slug: e.slug },
		props: {
			lesson: meta[i],
			Content: e.Content,
			lessons: meta,
			prev: meta[i - 1] ?? null,
			next: meta[i + 1] ?? null,
		},
	}));
}

const { lesson, Content, lessons, prev, next } = Astro.props;
---

<Lesson lesson={lesson} lessons={lessons} prev={prev} next={next}>
	<Content />
	<LessonComplete slug={lesson.slug} />
</Lesson>
