---
interface Step {
	n: number;
	title: string;
	/** 없으면 아직 페이지가 없는 단계로 보고 링크 없이 그린다. */
	href?: string;
}

interface Props {
	title?: string;
	lang?: string;
	/** false면 사이드바를 그리지 않는다(홈). */
	sidebar?: boolean;
	/** 0~8단계 목차. href는 사이트 루트 기준 경로(예: "/tour/"). */
	steps?: Step[];
	/** 현재 단계 번호(0~8). 목차에서 강조한다. */
	currentStep?: number;
	/** 푸터 저장소 링크. 없으면 링크를 그리지 않는다. */
	repoUrl?: string;
}

const siteName = '반도체 4개 국어 학습';
const { title, lang = 'ko', sidebar = true, steps = [], currentStep, repoUrl } = Astro.props;
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const rawPath = Astro.url.pathname;
const relPath = (rawPath.startsWith(base) ? rawPath.slice(base.length) : rawPath).replace(/\/+$/, '');
const onHome = relPath === '';
const onTour = relPath.startsWith('/tour');
const onGlossary = relPath.startsWith('/glossary');

// 단계(module)별 레슨 slug. 진도 표시에 쓴다.
const lessonModules = import.meta.glob('../content/lessons/*.mdx', { eager: true }) as Record<string, any>;
const stepLessons: Record<number, string[]> = {};
const firstOrder: Record<number, number> = {};
const firstSlug: Record<number, string> = {};
for (const [path, mod] of Object.entries(lessonModules)) {
	const slug = path.split('/').pop()!.replace(/\.mdx$/, '');
	const m = Number(mod.frontmatter?.module ?? -1);
	if (!stepLessons[m]) stepLessons[m] = [];
	stepLessons[m].push(slug);
	const order = Number(mod.frontmatter?.order ?? 0);
	if (!(m in firstOrder) || order < firstOrder[m]) {
		firstOrder[m] = order;
		firstSlug[m] = slug;
	}
}

// steps를 넘기지 않은 페이지(용어집 등)는 레슨 페이지와 같은 목차를 쓴다.
const defaultSteps = [
	'칩 하나 만들어 보기',
	'기초 원리',
	'제품과 산업',
	'팹과 클린룸',
	'전공정',
	'계측·검사·수율',
	'후공정',
	'최신 기술',
	'현장 소통',
].map((t, n) => ({
	n,
	title: t,
	href: n === 0 ? '/tour/' : firstSlug[n] ? `/lessons/${firstSlug[n]}/` : '',
}));
const tocSteps = steps.length > 0 ? steps : defaultSteps;

const langOptions = [
	{ value: 'en', label: 'English', lang: 'en' },
	{ value: 'ja', label: '日本語', lang: 'ja' },
	{ value: 'zh-Hans', label: '简体中文', lang: 'zh-Hans' },
	{ value: 'zh-Hant', label: '繁體中文', lang: 'zh-Hant' },
];
---

<!doctype html>
<html lang={lang} data-learn-lang="en ja zh-Hans zh-Hant">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500&family=IBM+Plex+Sans:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap"
		/>
		<title>{pageTitle}</title>
		<script is:inline>
			(function () {
				var root = document.documentElement;
				var theme = null;
				var codes = ['en', 'ja', 'zh-Hans', 'zh-Hant'];
					var learn = codes.join(' ');
				try {
					theme = localStorage.getItem('theme');
					var saved = localStorage.getItem('learn-lang');
					if (saved === 'none') {
							learn = 'none';
						} else if (saved) {
							// 저장값은 "en,ja" 같은 목록 또는 예전 단일 값("en")이다
							var picked = codes.filter(function (c) { return saved.split(',').indexOf(c) !== -1; });
							if (picked.length) learn = picked.join(' ');
						}
				} catch (e) {}
				if (theme === 'light' || theme === 'dark') root.dataset.theme = theme;
				root.dataset.learnLang = learn;
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main">본문으로 건너뛰기</a>

		<header class="site-header">
			{
				sidebar && (
					<button
						class="icon-button menu-button"
						type="button"
						aria-label="목차 열기"
						aria-controls="sidebar"
						aria-expanded="false"
						data-menu-toggle
					>
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
						</svg>
					</button>
				)
			}
			<a class="site-title" href={`${base}/`}>{siteName}</a>
			<nav class="main-nav" aria-label="주요 메뉴">
				<a class="nav-link" href={`${base}/`} aria-current={onHome ? 'page' : undefined}>학습 경로</a>
				<a class="nav-link" href={`${base}/tour/`} aria-current={onTour ? 'page' : undefined}>칩 하나 만들어 보기</a>
				<a class="nav-link" href={`${base}/glossary/`} aria-current={onGlossary ? 'page' : undefined}>용어집</a>
			</nav>
			<div class="header-actions">
				<slot name="header" />
				<details class="lang-picker">
					<summary class="lang-summary">함께 볼 언어</summary>
					<div class="lang-menu" role="group" aria-label="함께 볼 언어">
						<label class="lang-check"><input type="checkbox" data-lang-all /><span>전체</span></label>
						{
							langOptions.map((o) => (
								<label class="lang-check"><input type="checkbox" value={o.value} data-lang-check /><span lang={o.lang}>
									{o.label}
								</span></label>
							))
						}
					</div>
				</details>
				<button class="icon-button" type="button" aria-label="다크 모드 전환" data-theme-toggle>
					<svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
						<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="currentColor"></path>
					</svg>
					<svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
						<circle cx="12" cy="12" r="4" fill="currentColor"></circle>
						<path
							d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1 7 17M17 7l2.1-2.1"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"></path>
					</svg>
				</button>
			</div>
		</header>

		<div class:list={['layout', !sidebar && 'is-full']}>
			{
				sidebar && (
					<aside class="sidebar" id="sidebar" aria-label="목차">
						<slot name="sidebar">
							<nav class="toc" aria-label="학습 경로">
								<p class="toc-title">학습 경로</p>
								<ol class="toc-list">
									{tocSteps.map((s) => (
										<li>
											{s.href ? (
												<a href={`${base}${s.href}`} aria-current={s.n === currentStep ? 'step' : undefined}>
													<span class="toc-no">{s.n}</span>
													<span>{s.title}</span>
														{stepLessons[s.n]?.length > 0 && <span class="toc-progress" data-step-progress={s.n}>0/{stepLessons[s.n].length}</span>}
												</a>
											) : (
												<span class="toc-pending">
													<span class="toc-no">{s.n}</span>
													<span>{s.title}</span>
													{stepLessons[s.n]?.length > 0 && <span class="toc-progress" data-step-progress={s.n}>0/{stepLessons[s.n].length}</span>}
														<span class="toc-soon">준비 중</span>
												</span>
											)}
										</li>
									))}
								</ol>
							</nav>
						</slot>
					</aside>
				)
			}
			<main class="content" id="main">
				<slot />
			</main>
		</div>

		<footer class="site-footer">
			<p>반도체 입문자가 기초부터 공정까지 한·영·일·중 용어로 익히는 무료 학습 사이트.</p>
			{repoUrl && (
				<a href={repoUrl} target="_blank" rel="noopener">저장소</a>
			)}
		</footer>

		<script is:inline>
			(function () {
				var root = document.documentElement;
				var body = document.body;
				var themeButton = document.querySelector('[data-theme-toggle]');
				var menuButton = document.querySelector('[data-menu-toggle]');
				var langBoxes = Array.prototype.slice.call(document.querySelectorAll('[data-lang-check]'));
				var langAll = document.querySelector('[data-lang-all]');

				function currentLangs() {
					return langBoxes.filter(function (b) { return b.checked; }).map(function (b) { return b.value; });
				}

				function syncLangAll() {
					var n = currentLangs().length;
					langAll.checked = n === langBoxes.length;
					langAll.indeterminate = n > 0 && n < langBoxes.length;
				}

				var activeLangs = root.dataset.learnLang.split(' ');
				langBoxes.forEach(function (b) {
					b.checked = activeLangs.indexOf(b.value) !== -1;
				});
				syncLangAll();

				function applyLangs() {
					var on = currentLangs();
					root.dataset.learnLang = on.length ? on.join(' ') : 'none';
					syncLangAll();
					try {
						localStorage.setItem('learn-lang', on.length ? on.join(',') : 'none');
					} catch (e) {}
				}

				langAll.addEventListener('change', function () {
					langBoxes.forEach(function (b) { b.checked = langAll.checked; });
					applyLangs();
				});
				langBoxes.forEach(function (b) {
					b.addEventListener('change', applyLangs);
				});

				syncLangAll();

				themeButton.addEventListener('click', function () {
					var current =
						root.dataset.theme ||
						(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
					var next = current === 'dark' ? 'light' : 'dark';
					root.dataset.theme = next;
					try {
						localStorage.setItem('theme', next);
					} catch (e) {}
				});


				function setMenu(open) {
					body.classList.toggle('sidebar-open', open);
					if (!menuButton) return;
					var wasOpen = menuButton.getAttribute('aria-expanded') === 'true';
					menuButton.setAttribute('aria-expanded', String(open));
					menuButton.setAttribute('aria-label', open ? '목차 닫기' : '목차 열기');
					if (open === wasOpen) return;
					// 서랍을 열면 초점을 서랍 안으로, 닫으면 버튼으로 되돌린다
					if (open) {
						var first = document.querySelector(
							'#sidebar a[href], #sidebar button, #sidebar input, #sidebar select, #sidebar [tabindex]'
						);
						// 서랍이 보이기 시작한 뒤에야 초점을 받을 수 있다
						if (first) setTimeout(function () { first.focus(); }, 220);
					} else {
						menuButton.focus();
					}
				}

				if (menuButton) {
					menuButton.addEventListener('click', function () {
						setMenu(!body.classList.contains('sidebar-open'));
					});
				}

				document.addEventListener('keydown', function (e) {
					if (e.key === 'Escape') setMenu(false);
				});
			})();
		</script>

		<script is:inline define:vars={{ stepLessons }}>
			(function () {
				var KEY = 'learn-progress';
				function readDone() {
					try {
						var v = JSON.parse(localStorage.getItem(KEY) || '[]');
						return Array.isArray(v) ? v : [];
					} catch (e) {
						return [];
					}
				}
				function renderToc() {
					var done = readDone();
					document.querySelectorAll('[data-step-progress]').forEach(function (el) {
						var list = stepLessons[el.getAttribute('data-step-progress')] || [];
						var count = list.filter(function (slug) {
							return done.indexOf(slug) !== -1;
						}).length;
						el.textContent = count + '/' + list.length;
						el.classList.toggle('is-done', list.length > 0 && count === list.length);
					});
				}
				window.addEventListener('learn-progress-change', renderToc);
				renderToc();
			})();
		</script>
	</body>
</html>

<style is:global>
	/* 1. 토큰 (라이트 기본값) */
	:root,
	:root[data-theme='light'] {
		color-scheme: light;

		--bg: #f6f8fa;
		--surface: #ffffff;
		--surface-sunken: #eceff3;
		--border: #d5dbe3;
		--border-strong: #7a8797;
		--text: #17202b;
		--text-muted: #556170;
		--primary: #2447b8;
		--primary-soft: #e3eafb;
		--on-primary: #ffffff;
		--accent: #a8521a;
		--accent-soft: #f8eadb;
		--success: #1a7a4c;
		--danger: #b3261e;
		--warning: #8a6100;
		--focus: #2447b8;

		--diagram-stroke: #17202b;
		--diagram-silicon: #5c6778;
		--diagram-sand: #d9b877;
		--diagram-copper: #d68a45;
		--diagram-oxide: #7fa8d9;
		--diagram-resist: #b8477a;
		--diagram-light: #7a4fd6;

		--shadow-overlay: 0 8px 24px rgba(23, 32, 43, 0.18);
	}

	/* 2. 다크 모드 (사용자 선택 우선, 없으면 시스템 설정) */
	:root[data-theme='dark'] {
		color-scheme: dark;

		--bg: #0f141a;
		--surface: #171d25;
		--surface-sunken: #0b0f14;
		--border: #2a3340;
		--border-strong: #5d6b7d;
		--text: #e6eaf0;
		--text-muted: #9ba7b6;
		--primary: #8fb0ff;
		--primary-soft: #1b2947;
		--on-primary: #0f141a;
		--accent: #e39a5c;
		--accent-soft: #3a2615;
		--success: #5fcf96;
		--danger: #ff8a80;
		--warning: #f2c14e;
		--focus: #8fb0ff;

		--diagram-stroke: #e6eaf0;
		--diagram-silicon: #a3aebd;
		--diagram-sand: #d9b877;
		--diagram-copper: #d68a45;
		--diagram-oxide: #6f9bd1;
		--diagram-resist: #e07aa8;
		--diagram-light: #b59bff;

		--shadow-overlay: 0 8px 24px rgba(0, 0, 0, 0.5);
	}

	@media (prefers-color-scheme: dark) {
		:root:not([data-theme='light']) {
			color-scheme: dark;

			--bg: #0f141a;
			--surface: #171d25;
			--surface-sunken: #0b0f14;
			--border: #2a3340;
			--border-strong: #5d6b7d;
			--text: #e6eaf0;
			--text-muted: #9ba7b6;
			--primary: #8fb0ff;
			--primary-soft: #1b2947;
			--on-primary: #0f141a;
			--accent: #e39a5c;
			--accent-soft: #3a2615;
			--success: #5fcf96;
			--danger: #ff8a80;
			--warning: #f2c14e;
			--focus: #8fb0ff;

			--diagram-stroke: #e6eaf0;
			--diagram-silicon: #a3aebd;
			--diagram-sand: #d9b877;
			--diagram-copper: #d68a45;
			--diagram-oxide: #6f9bd1;
			--diagram-resist: #e07aa8;
			--diagram-light: #b59bff;

			--shadow-overlay: 0 8px 24px rgba(0, 0, 0, 0.5);
		}
	}

	:root {
		/* 글꼴 (lang 속성으로 묶음 선택) */
		--font-sans-ko: 'IBM Plex Sans', 'Noto Sans KR', 'Apple SD Gothic Neo', 'Malgun Gothic', system-ui, sans-serif;
		--font-sans-ja: 'IBM Plex Sans', 'Noto Sans JP', 'Hiragino Sans', 'Yu Gothic', system-ui, sans-serif;
		--font-sans-sc: 'IBM Plex Sans', 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', system-ui, sans-serif;
		--font-sans-tc: 'IBM Plex Sans', 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', system-ui, sans-serif;
		--font-mono: 'IBM Plex Mono', ui-monospace, Consolas, Menlo, monospace;

		/* 글자 크기 / 줄 높이 */
		--fs-display: 44px;
		--lh-display: 52px;
		--fs-h1: 32px;
		--lh-h1: 40px;
		--fs-h2: 24px;
		--lh-h2: 32px;
		--fs-h3: 20px;
		--lh-h3: 28px;
		--fs-lead: 18px;
		--lh-lead: 30px;
		--fs-body: 16px;
		--lh-body: 28px;
		--fs-small: 14px;
		--lh-small: 22px;
		--fs-caption: 12px;
		--lh-caption: 18px;
		--fs-term-main: 24px;
		--lh-term-main: 32px;
		--fs-term-sub: 18px;
		--lh-term-sub: 26px;
		--fs-reading: 13px;
		--lh-reading: 20px;
		--fs-mono: 14px;
		--lh-mono: 22px;

		/* 간격 */
		--space-1: 4px;
		--space-2: 8px;
		--space-3: 12px;
		--space-4: 16px;
		--space-5: 24px;
		--space-6: 32px;
		--space-7: 48px;
		--space-8: 64px;

		/* 모서리 */
		--radius-sm: 4px;
		--radius-md: 8px;
		--radius-lg: 12px;
		--radius-full: 999px;

		/* 틀 */
		--header-h: 56px;
		--sidebar-w: 264px;
		--content-max: 720px;
		--touch-min: 44px;

		/* 이전 변수 별칭 (기존 컴포넌트 호환) */
		--color-bg: var(--bg);
		--color-surface: var(--surface);
		--color-text: var(--text);
		--color-text-muted: var(--text-muted);
		--color-border: var(--border);
		--color-accent: var(--primary);
		--color-accent-soft: var(--primary-soft);
		--font-sans: var(--font-sans-ko);
		--text-sm: var(--fs-small);
		--text-base: var(--fs-body);
		--text-lg: var(--fs-h3);
		--text-xl: var(--fs-h1);
		--line-height: 1.75;
		--radius: var(--radius-md);
		--header-height: var(--header-h);
		--sidebar-width: var(--sidebar-w);
		--content-width: var(--content-max);
	}

	/* 720px 미만: 내비게이션이 두 번째 줄로 내려오므로 헤더 높이를 늘린다 */
	@media (max-width: 719px) {
		:root {
			--header-h: 100px;
		}
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		scroll-padding-top: calc(var(--header-h) + var(--space-3));
		font-family: var(--font-sans-ko);
	}

	:lang(ko) {
		font-family: var(--font-sans-ko);
	}

	:lang(ja) {
		font-family: var(--font-sans-ja);
	}

	:lang(zh-Hans) {
		font-family: var(--font-sans-sc);
	}

	:lang(zh-Hant) {
		font-family: var(--font-sans-tc);
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-size: var(--fs-body);
		line-height: var(--lh-body);
		word-break: keep-all;
		overflow-wrap: anywhere;
	}

	a {
		color: var(--primary);
	}

	button,
	select {
		font: inherit;
		color: inherit;
	}

	h1,
	h2,
	h3 {
		margin: 0 0 var(--space-3);
	}

	h1 {
		font-size: var(--fs-h1);
		line-height: var(--lh-h1);
		font-weight: 700;
	}

	h2 {
		font-size: var(--fs-h2);
		line-height: var(--lh-h2);
		font-weight: 700;
	}

	h3 {
		font-size: var(--fs-h3);
		line-height: var(--lh-h3);
		font-weight: 600;
	}

	code,
	pre {
