---
interface Props {
	id: string; // YouTube 영상 id
	title: string;
	start?: number; // 시작 위치(초)
	playLabel?: string;
}

const { id, title, start, playLabel = '영상 재생' } = Astro.props;
const watchUrl = `https://www.youtube.com/watch?v=${id}${start ? `&t=${start}s` : ''}`;
---

<div class="video" data-video-id={id} data-video-start={start} data-video-title={title}>
	<a class="facade" href={watchUrl} target="_blank" rel="noopener noreferrer" data-video-play>
		<svg viewBox="0 0 68 48" width="68" height="48" aria-hidden="true">
			<rect width="68" height="48" rx="12" fill="var(--color-accent)"></rect>
			<path d="M27 14v20l18-10z" fill="var(--color-bg)"></path>
		</svg>
		<span class="title">{title}</span>
		<span class="hint">{playLabel} · YouTube</span>
	</a>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-video-id]').forEach((video) => {
		const play = video.querySelector<HTMLAnchorElement>('[data-video-play]')!;

		play.addEventListener('click', (event) => {
			event.preventDefault();

			const params = new URLSearchParams({ autoplay: '1', rel: '0' });
			if (video.dataset.videoStart) params.set('start', video.dataset.videoStart);

			const iframe = document.createElement('iframe');
			iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(video.dataset.videoId!)}?${params}`;
			iframe.title = video.dataset.videoTitle!;
			iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
			iframe.allowFullscreen = true;
			iframe.referrerPolicy = 'strict-origin-when-cross-origin';

			play.replaceWith(iframe);
			iframe.focus();
		});
	});
</script>

<style>
	.video {
		aspect-ratio: 16 / 9;
		margin: var(--space-4) 0;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: var(--color-surface);
		overflow: hidden;
	}

	.facade {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: var(--space-2);
		width: 100%;
		height: 100%;
		padding: var(--space-3);
		color: var(--color-text);
		text-align: center;
		text-decoration: none;
	}

	.facade:hover svg {
		transform: scale(1.08);
	}

	svg {
		transition: transform 0.15s ease;
	}

	.title {
		font-weight: 700;
	}

	.hint {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.video :global(iframe) {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
	}

	@media (prefers-reduced-motion: reduce) {
		svg {
			transition: none;
		}
	}
</style>
