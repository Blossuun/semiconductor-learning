---
import { getCollection } from 'astro:content';
import { audioPath } from '../scripts/audio-path';

interface Props {
	modules: string[];
}

const { modules } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const entries = (await getCollection('glossary'))
	.filter((t) => Boolean(t.data.definition_ko))
	.map((t) => ({
		id: t.id,
		module: Number(t.data.module),
		ko: t.data.ko,
		abbr: t.data.abbr ?? '',
		def: t.data.definition_ko ?? '',
		en: t.data.en ?? '',
		ja: t.data.ja ?? '',
		jaRead: t.data.ja_reading ?? '',
		zhHans: t.data.zh_cn ?? '',
		zhHansRead: t.data.zh_cn_pinyin ?? '',
		zhHant: t.data.zh_tw ?? '',
		zhHantRead: t.data.zh_tw_pinyin ?? '',
		audio: {
			en: audioPath('terms', t.id, 'en') ?? '',
			ja: audioPath('terms', t.id, 'ja') ?? '',
			zh_cn: audioPath('terms', t.id, 'zh_cn') ?? '',
			zh_tw: audioPath('terms', t.id, 'zh_tw') ?? '',
		},
	}));

const poolJson = JSON.stringify({ modules, entries }).replace(/</g, '\\u003c');

// 용어가 0개인 단계는 단계 버튼을 그리지 않는다.
const stageCounts = modules.map((_, i) => entries.filter((e) => e.module === i).length);

const langs = [
	{ key: 'en', label: 'English', lang: 'en' },
	{ key: 'ja', label: '日本語', lang: 'ja' },
	{ key: 'zh-Hans', label: '简体中文', lang: 'zh-Hans' },
	{ key: 'zh-Hant', label: '繁體中文', lang: 'zh-Hant' },
];
---

<section class="tq" data-tq-root aria-labelledby="tq-title">
	<h2 id="tq-title">용어 맞히기</h2>
	<p class="tq-lead">문제를 읽고 알맞은 보기를 고르세요. 보기는 고른 언어로 나옵니다.</p>

	<div class="tq-controls">
		<div class="tq-group" role="group" aria-labelledby="tq-stage-label">
			<span id="tq-stage-label" class="tq-label">단계</span>
			<div class="tq-pills">
				<button type="button" class="tq-pill" data-tq-stage="" aria-pressed="true">전체</button>
				{
					modules.map((name, i) => stageCounts[i] > 0 && (
						<button type="button" class="tq-pill" data-tq-stage={String(i)} aria-pressed="false" aria-label={`${i}단계 ${name}`}>
							{i}단계
						</button>
					))
				}
			</div>
		</div>
		<div class="tq-group" role="group" aria-labelledby="tq-dir-label">
			<span id="tq-dir-label" class="tq-label">출제 방향</span>
			<div class="tq-pills">
				<button type="button" class="tq-pill" data-tq-dir="def" aria-pressed="true">뜻풀이 → 고른 언어 표기</button>
				<button type="button" class="tq-pill" data-tq-dir="ko" aria-pressed="false">한국어 용어 → 고른 언어 표기</button>
			</div>
		</div>
		<div class="tq-group" role="group" aria-labelledby="tq-scope-label">
				<span id="tq-scope-label" class="tq-label">출제 범위</span>
				<div class="tq-pills">
					<button type="button" class="tq-pill" data-tq-saved aria-pressed="false">저장한 용어만</button>
				</div>
			</div>
			<div class="tq-group" role="group" aria-labelledby="tq-lang-label">
			<span id="tq-lang-label" class="tq-label">보기 언어</span>
			<div class="tq-pills">
				{
					langs.map((l) => (
						<button type="button" class="tq-pill" data-tq-lang={l.key} lang={l.lang} aria-pressed={l.key === 'en' ? 'true' : 'false'}>
							{l.label}
						</button>
					))
				}
			</div>
		</div>
	</div>

	<p class="tq-meta" aria-live="polite" data-tq-meta></p>

	<div class="tq-card" data-tq-card>
		<p class="tq-q-label"><span class="tq-number">Q</span> <span data-tq-qtext>이 뜻풀이에 맞는 용어는?</span></p>
		<p class="tq-def" data-tq-def></p>
		<div class="tq-choices" data-tq-choices></div>
		<div class="tq-feedback" data-tq-feedback hidden>
			<p class="tq-result" data-tq-result aria-live="polite"></p>
			<p class="tq-answer" data-tq-answer></p>
			<div class="tq-actions">
				<button type="button" class="tq-speak" data-tq-speak aria-label="정답 발음 듣기" data-speak="" data-speak-lang="" data-audio="">
					<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
						<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
						<path d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
					</svg>
				</button>
				<a class="tq-term-link" data-tq-term-link href={`${base}/glossary/`}>용어 카드 보기</a>
			</div>
			<button type="button" class="tq-next" data-tq-next>다음 문제</button>
		</div>
	</div>

	<p class="tq-empty" hidden data-tq-empty>이 조건에서는 보기 4개를 만들 수 없습니다. 다른 단계나 언어를 고르세요.</p>

	<script is:inline type="application/json" data-tq-pool set:html={poolJson}></script>
</section>

<script>
	type Entry = {
		id: string;
		module: number;
		ko: string;
		abbr: string;
		def: string;
		en: string;
		ja: string;
		jaRead: string;
		zhHans: string;
		zhHansRead: string;
		zhHant: string;
		zhHantRead: string;
		audio: Record<string, string>;
	};

	type Lang = 'en' | 'ja' | 'zh-Hans' | 'zh-Hant';
	type Dir = 'def' | 'ko';

	const FIELDS: Record<Lang, { text: (e: Entry) => string; read: (e: Entry) => string }> = {
		en: { text: (e) => e.en, read: () => '' },
		ja: { text: (e) => e.ja, read: (e) => e.jaRead },
		'zh-Hans': { text: (e) => e.zhHans, read: (e) => e.zhHansRead },
		'zh-Hant': { text: (e) => e.zhHant, read: (e) => e.zhHantRead },
	};

	// 저장한 용어 id 목록(TermCard의 저장 버튼이 쓰는 키와 같다).
	const SAVED_TERMS_KEY = 'sc-saved-terms';
	function readSaved(): Set<string> {
		try {
			const v: unknown = JSON.parse(localStorage.getItem(SAVED_TERMS_KEY) ?? '[]');
			return new Set(Array.isArray(v) ? v.filter((x): x is string => typeof x === 'string') : []);
		} catch {
			return new Set<string>();
		}
	}

	const SPEAK: Record<Lang, { speak: string; audio: string }> = {
		en: { speak: 'en-US', audio: 'en' },
		ja: { speak: 'ja-JP', audio: 'ja' },
		'zh-Hans': { speak: 'zh-CN', audio: 'zh_cn' },
		'zh-Hant': { speak: 'zh-TW', audio: 'zh_tw' },
	};

	// 헤더에서 고른 언어(learn-lang) 중 첫 번째. 없으면 null.
	function headerLang(): Lang | null {
		try {
			const raw = localStorage.getItem('learn-lang') ?? '';
			for (const k of raw.split(',')) {
				const key = k.trim();
				if (key === 'en' || key === 'ja' || key === 'zh-Hans' || key === 'zh-Hant') return key;
			}
		} catch {
			// 무시
		}
		return null;
	}

	function shuffle<T>(arr: T[]): T[] {
		const a = arr.slice();
		for (let i = a.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1));
			[a[i], a[j]] = [a[j], a[i]];
		}
		return a;
	}

	function init(root: HTMLElement) {
		const data = JSON.parse(root.querySelector<HTMLScriptElement>('[data-tq-pool]')!.textContent ?? '{}') as {
			modules: string[];
			entries: Entry[];
		};
		const pool = data.entries;

		const stageButtons = root.querySelectorAll<HTMLButtonElement>('[data-tq-stage]');
		const dirButtons = root.querySelectorAll<HTMLButtonElement>('[data-tq-dir]');
		const langButtons = root.querySelectorAll<HTMLButtonElement>('[data-tq-lang]');
		const meta = root.querySelector<HTMLElement>('[data-tq-meta]')!;
		const card = root.querySelector<HTMLElement>('[data-tq-card]')!;
		const qTextEl = root.querySelector<HTMLElement>('[data-tq-qtext]')!;
		const defEl = root.querySelector<HTMLElement>('[data-tq-def]')!;
		const choicesEl = root.querySelector<HTMLElement>('[data-tq-choices]')!;
		const feedback = root.querySelector<HTMLElement>('[data-tq-feedback]')!;
		const resultEl = root.querySelector<HTMLElement>('[data-tq-result]')!;
		const answerEl = root.querySelector<HTMLElement>('[data-tq-answer]')!;
		const nextBtn = root.querySelector<HTMLButtonElement>('[data-tq-next]')!;
		const empty = root.querySelector<HTMLElement>('[data-tq-empty]')!;
		const savedBtn = root.querySelector<HTMLButtonElement>('[data-tq-saved]')!;

		let stage = '';
		// 저장한 용어만 출제: 문제는 저장한 용어에서 내고, 보기는 단계 안의 모든 용어에서 뽑는다.
		let savedOnly = false;
		let saved = new Set<string>();
		let stagePool: Entry[] = [];
		let dir: Dir = 'def';
		let lang: Lang = headerLang() ?? 'en';
		const speakBtn = root.querySelector<HTMLButtonElement>('[data-tq-speak]')!;
		const termLink = root.querySelector<HTMLAnchorElement>('[data-tq-term-link]')!;
		const baseHref = termLink.getAttribute('href') ?? '';
		langButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tqLang === lang)));
		let score = 0;
		let total = 0;
		let lastId: string | null = null;
		let answered = false;
		// 회차: 출제 조건(단계·방향·언어)이 바뀌면 새로 시작한다.
		// 회차의 문제 줄이 비면 회차가 끝난 것이고, 틀린 문제는 줄 뒤쪽에 다시 들어가 있다.
		let roundSet: Entry[] = [];
		let queue: Entry[] = [];
		let cleared = new Set<string>();

		const textOf = (e: Entry) => FIELDS[lang].text(e).trim();
		const readOf = (e: Entry) => FIELDS[lang].read(e).trim();

		const candidates = () =>
			pool.filter((e) => (stage === '' || e.module === Number(stage)) && textOf(e) !== '');

		const uniqueByText = (list: Entry[]) => {
			const seen = new Set<string>();
			return list.filter((e) => {
				const t = textOf(e);
				if (seen.has(t)) return false;
				seen.add(t);
				return true;
			});
		};

		const startRound = () => {
			stagePool = uniqueByText(candidates());
				saved = readSaved();
				roundSet = savedOnly ? stagePool.filter((e) => saved.has(e.id)) : stagePool;
			queue = shuffle(roundSet);
			cleared = new Set();
		};

		const updateMeta = () => {
			meta.textContent = `${roundSet.length}개 용어 · 회차 ${cleared.size} / ${roundSet.length} · 맞힌 수 ${score} / ${total}`;
		};

		const next = () => {
			answered = false;
			feedback.hidden = true;
			choicesEl.replaceChildren();

			if (queue.length === 0) startRound();
			if (roundSet.length === 0 || stagePool.length < 4) {
				card.hidden = true;
				empty.hidden = false;
				empty.textContent =
					stagePool.length < 4
						? '이 조건에서는 보기 4개를 만들 수 없습니다. 다른 단계나 언어를 고르세요.'
						: '저장한 용어가 없습니다. 용어 카드의 저장 버튼을 누른 뒤 다시 고르세요.';
				meta.textContent = '';
				return;
			}
			card.hidden = false;
			empty.hidden = true;

			// 방금 낸 문제가 바로 다시 나오지 않게 한다(남은 문제가 하나뿐이면 그대로 낸다).
			if (queue.length > 1 && queue[0].id === lastId) queue.push(queue.shift()!);
			const question = queue.shift()!;
			lastId = question.id;

			const answerText = textOf(question);

			// 오답 보기는 정답과 같은 단계에서 먼저 뽑고, 모자라면 다른 단계에서 채운다.
			// 같은 단계가 먼저, 저장한 만큼만 출제할 때는 저장하지 않은 용어가 뒤로 간다(모자라는 보기는 저장하지 않은 용어로 채운다).
				const rank = (e: Entry) => (e.module === question.module ? 0 : 2) + (savedOnly && !saved.has(e.id) ? 1 : 0);
			const others = shuffle(stagePool.filter((e) => e.id !== question.id));
			const distractors = others.sort((a, b) => rank(a) - rank(b)).slice(0, 3);
			const options = shuffle([question, ...distractors]);
			const answerIndex = options.indexOf(question);

			if (dir === 'ko') {
				qTextEl.textContent = '이 한국어 용어를 고른 언어로 쓰면?';
				defEl.textContent = question.abbr ? `${question.ko} (${question.abbr})` : question.ko;
				defEl.classList.add('is-term');
			} else {
				qTextEl.textContent = '이 뜻풀이에 맞는 용어는?';
				defEl.textContent = question.def;
				defEl.classList.remove('is-term');
			}
			updateMeta();

			options.forEach((opt, index) => {
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'tq-choice';
				button.dataset.tqIndex = String(index);

				const text = document.createElement('span');
				text.className = 'tq-text';
				text.lang = lang;
				text.textContent = textOf(opt);
				button.appendChild(text);

				const read = readOf(opt);
				if (read) {
					const readEl = document.createElement('span');
					readEl.className = 'tq-read';
					readEl.textContent = read;
					button.appendChild(readEl);
				}

				button.addEventListener('click', () => {
					if (answered) return;
					answered = true;
					total++;
					const correct = index === answerIndex;
					if (correct) {
						score++;
						cleared.add(question.id);
					} else {
						// 틀린 문제는 이번 회차 뒤쪽에 다시 넣는다.
						queue.push(question);
					}

					choicesEl.querySelectorAll<HTMLButtonElement>('[data-tq-index]').forEach((b) => {
						const i = Number(b.dataset.tqIndex);
						b.setAttribute('aria-disabled', 'true');
						b.setAttribute('aria-pressed', String(i === index));
						if (i === answerIndex) b.classList.add('is-correct');
						else if (i === index) b.classList.add('is-wrong');
					});

					// 보기 4개 모두에 한국어 뜻을 보여 준다.
					choicesEl.querySelectorAll<HTMLButtonElement>('[data-tq-index]').forEach((b) => {
						const o = options[Number(b.dataset.tqIndex)];
						const ko = document.createElement('span');
						ko.className = 'tq-ko';
						ko.lang = 'ko';
						ko.textContent = o.abbr ? `${o.ko} (${o.abbr})` : o.ko;
						b.appendChild(ko);
					});

					speakBtn.setAttribute('data-speak', answerText);
					speakBtn.setAttribute('data-speak-lang', SPEAK[lang].speak);
					const audioSrc = question.audio[SPEAK[lang].audio];
					if (audioSrc) speakBtn.setAttribute('data-audio', audioSrc);
					else speakBtn.removeAttribute('data-audio');
					// 처음 그릴 때 붙은 "음성 없음" 안내는 mp3가 생기면 지운다.
					const note = speakBtn.nextElementSibling;
					if (audioSrc && note?.classList.contains('speak-unavailable')) note.remove();
					speakBtn.lang = lang;
					termLink.href = `${baseHref}#term-${question.id}`;

					resultEl.textContent = correct ? '정답입니다.' : '오답입니다.';
					resultEl.className = `tq-result ${correct ? 'is-correct' : 'is-wrong'}`;
					answerEl.textContent = `정답: ${question.ko}${question.abbr ? ` (${question.abbr})` : ''} · ${answerText}`;
					feedback.hidden = false;
					updateMeta();
					nextBtn.focus();
				});

				choicesEl.appendChild(button);
			});
		};

		const restart = () => {
			score = 0;
			total = 0;
			lastId = null;
			startRound();
			next();
		};

		const setPressed = (buttons: NodeListOf<HTMLButtonElement>, active: HTMLButtonElement) => {
			buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === active)));
		};

		stageButtons.forEach((button) => {
			button.addEventListener('click', () => {
				stage = button.dataset.tqStage ?? '';
				setPressed(stageButtons, button);
				restart();
			});
		});

		dirButtons.forEach((button) => {
			button.addEventListener('click', () => {
				dir = (button.dataset.tqDir ?? 'def') as Dir;
				setPressed(dirButtons, button);
				restart();
			});
		});

		langButtons.forEach((button) => {
			button.addEventListener('click', () => {
				lang = (button.dataset.tqLang ?? 'en') as Lang;
				setPressed(langButtons, button);
				restart();
			});
		});

		savedBtn.addEventListener('click', () => {
			savedOnly = !savedOnly;
			savedBtn.setAttribute('aria-pressed', String(savedOnly));
			restart();
		});

		nextBtn.addEventListener('click', next);

		restart();
	}

	document.querySelectorAll<HTMLElement>('[data-tq-root]').forEach(init);
</script>

<style>
	.tq {
		margin: var(--space-7) 0 0;
		padding-top: var(--space-5);
		border-top: 1px solid var(--border);
	}

	h2 {
		margin: 0;
		color: var(--text);
		font-size: var(--fs-h2, 24px);
		line-height: var(--lh-h2, 32px);
		font-weight: 700;
	}

	.tq-lead {
		margin: var(--space-1) 0 0;
		color: var(--text-muted);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
	}

	.tq-controls {
		display: grid;
		gap: var(--space-3);
		margin-top: var(--space-4);
	}

	.tq-group {
		display: grid;
		gap: var(--space-1);
	}

	.tq-label {
		color: var(--text-muted);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
	}

	.tq-pills {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-2);
	}

	.tq-pill {
		max-width: 100%;
		min-height: var(--touch-min);
		padding: 0 var(--space-3);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
		text-align: left;
		cursor: pointer;
	}

	.tq-pill[aria-pressed='true'] {
		border-color: var(--primary);
		background: var(--primary-soft);
		color: var(--primary);
	}

	.tq-pill:focus-visible,
	.tq-next:focus-visible,
	.tq-choices :global(.tq-choice:focus-visible) {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	.tq-meta {
		min-height: 1lh;
		margin: var(--space-4) 0 var(--space-2);
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 500;
	}

	.tq-card {
		min-width: 0;
		padding: var(--space-4) var(--space-5);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
	}

	.tq-card[hidden] {
		display: none;
	}

	.tq-q-label {
		margin: 0;
		color: var(--text-muted);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
	}

	.tq-number {
		color: var(--accent);
		font-family: var(--font-mono);
		font-weight: 500;
	}

	.tq-def {
		margin: var(--space-2) 0 0;
		color: var(--text);
		font-size: var(--fs-body);
		line-height: var(--lh-body);
		font-weight: 600;
		overflow-wrap: anywhere;
	}

	.tq-def.is-term {
		font-size: var(--fs-h2, 24px);
		line-height: var(--lh-h2, 32px);
		font-weight: 700;
	}

	.tq-choices {
		display: grid;
		gap: var(--space-2);
		margin-top: var(--space-4);
	}

	.tq-choices :global(.tq-choice) {
		display: flex;
