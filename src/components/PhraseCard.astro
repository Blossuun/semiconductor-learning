---
import { getEntry } from 'astro:content';
import { audioPath } from '../scripts/audio-path';

interface Props {
	id: string;
}

const { id } = Astro.props;
const entry = await getEntry('phrases', id);
if (!entry) {
	throw new Error(`PhraseCard: phrases.yaml에 id "${id}" 문장이 없습니다.`);
}
const p = entry.data;

const rows = [
	{ label: '한국어', lang: 'ko', speak: 'ko-KR', audio: audioPath('phrases', id, 'ko'), text: p.ko, reading: undefined },
	{ label: 'English', lang: 'en', speak: 'en-US', audio: audioPath('phrases', id, 'en'), text: p.en, reading: undefined },
	{ label: '日本語', lang: 'ja', speak: 'ja-JP', audio: audioPath('phrases', id, 'ja'), text: p.ja, reading: p.ja_reading },
	{ label: '简体中文', lang: 'zh-Hans', speak: 'zh-CN', audio: audioPath('phrases', id, 'zh_cn'), text: p.zh_cn, reading: p.zh_cn_pinyin },
	{ label: '繁體中文', lang: 'zh-Hant', speak: 'zh-TW', audio: audioPath('phrases', id, 'zh_tw'), text: p.zh_tw, reading: p.zh_tw_pinyin },
];
---

<article class="phrase-card" id={`phrase-${id}`}>
	<header class="head">
		<span class="situation">{p.situation}</span>
		<button class="save-btn" type="button" aria-pressed="false" data-save-phrase={id}>저장</button>
	</header>
	<div class="phrase-hide-bar" role="group" aria-label="가리기 연습" hidden>
		<button class="hide-btn" type="button" data-hide-mode="foreign" aria-pressed="false">외국어 가리기</button>
		<button class="hide-btn" type="button" data-hide-mode="ko" aria-pressed="false">한국어 가리기</button>
	</div>
	<div class="rows">
		{
			rows.map((row) => (
				<div class="row" data-lang={row.lang === 'ko' ? undefined : row.lang} lang={row.lang}>
					<span class="label">{row.label}</span>
					<span class="text">
						<button class="reveal" type="button" aria-label={`${row.label} 문장 보기`}>눌러서 보기</button>
						<span class="word">{row.text}</span>
						{row.reading && row.lang === 'ja' && (
								<>
									<button class="reading-toggle" type="button" aria-expanded="false" aria-label="日本語 읽기 보기">읽기 보기</button>
									<span class="reading" hidden>{row.reading}</span>
								</>
							)}
							{row.reading && row.lang !== 'ja' && <span class="reading">{row.reading}</span>}
					</span>
					<button
						class="speak"
						type="button"
						aria-label={`${row.label} 문장 듣기`}
						data-speak={row.text}
						data-speak-lang={row.speak}
						data-audio={row.audio}
					>
						<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
							<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
							<path d="M16.5 8.5a5 5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
						</svg>
					</button>
				</div>
			))
		}
	</div>
</article>

<script>
	import '../scripts/speak.ts';

	// 저장한 문장 id 목록(JSON 배열).
	const SAVED_PHRASES_KEY = 'sc-saved-phrases';

	const readSavedPhrases = (): string[] => {
		try {
			const v: unknown = JSON.parse(localStorage.getItem(SAVED_PHRASES_KEY) ?? '[]');
			return Array.isArray(v) ? v.filter((x): x is string => typeof x === 'string') : [];
		} catch {
			return [];
		}
	};

	const syncPhraseSaveButtons = () => {
		const saved = new Set(readSavedPhrases());
		document.querySelectorAll<HTMLButtonElement>('[data-save-phrase]').forEach((b) => {
			b.setAttribute('aria-pressed', String(saved.has(b.dataset.savePhrase ?? '')));
		});
	};

	syncPhraseSaveButtons();

	const root = document.documentElement;
	const bars = document.querySelectorAll<HTMLElement>('.phrase-hide-bar');
	// 페이지에 카드가 여러 개여도 첫 카드의 전환 버튼만 보인다.
	if (bars[0]) bars[0].hidden = false;

	function setMode(mode: string) {
		if (mode === 'none') root.removeAttribute('data-phrase-hide');
		else root.setAttribute('data-phrase-hide', mode);
		document.querySelectorAll('.phrase-card .row[data-revealed]').forEach((r) => r.removeAttribute('data-revealed'));
		document.querySelectorAll<HTMLElement>('.hide-btn').forEach((b) => {
			b.setAttribute('aria-pressed', String(b.dataset.hideMode === mode));
		});
	}

	document.addEventListener('click', (e) => {
		const target = e.target as HTMLElement;
		const save = target.closest<HTMLButtonElement>('[data-save-phrase]');
		if (save) {
			const id = save.dataset.savePhrase ?? '';
			const list = readSavedPhrases();
			const i = list.indexOf(id);
			if (i >= 0) list.splice(i, 1);
			else list.push(id);
			try {
				localStorage.setItem(SAVED_PHRASES_KEY, JSON.stringify(list));
			} catch {
				// 저장 공간을 쓸 수 없으면 버튼 상태만 그대로 둔다.
			}
			syncPhraseSaveButtons();
			return;
		}
		const btn = target.closest<HTMLElement>('.hide-btn');
		if (btn) {
			const mode = btn.dataset.hideMode ?? 'none';
			setMode(root.getAttribute('data-phrase-hide') === mode ? 'none' : mode);
			return;
		}
		const rt = target.closest<HTMLButtonElement>('.reading-toggle');
		if (rt) {
			const reading = rt.parentElement?.querySelector<HTMLElement>('.reading');
			if (reading) {
				const open = reading.hidden;
				reading.hidden = !open;
				rt.setAttribute('aria-expanded', String(open));
				rt.textContent = open ? '읽기 접기' : '읽기 보기';
			}
			return;
		}
		const reveal = target.closest<HTMLElement>('.phrase-card .reveal');
		if (reveal) {
			const row = reveal.closest<HTMLElement>('.row');
			row?.setAttribute('data-revealed', '');
			row?.querySelector<HTMLElement>('.speak')?.focus();
		}
	});
</script>

<style>
	.phrase-card {
		background: var(--surface, #ffffff);
		border: 1px solid var(--border, #d0d7de);
		border-radius: var(--radius-lg, 12px);
		padding: 16px;
		margin: 12px 0;
		color: var(--text, #1f2328);
	}
	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 8px;
		margin-bottom: 8px;
	}
	.save-btn {
		min-height: var(--touch-min, 44px);
		margin-left: auto;
		padding: 0 12px;
		border: 1px solid var(--border-strong, #7a8797);
		border-radius: var(--radius-md, 8px);
		background: var(--surface, #ffffff);
		color: var(--text, #17202b);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
	}
	.save-btn[aria-pressed='true'] {
		border-color: var(--primary, #2447b8);
		background: var(--primary-soft, #e3eafb);
		color: var(--primary, #2447b8);
	}
	.save-btn:focus-visible {
		outline: 2px solid var(--focus, #2447b8);
		outline-offset: 2px;
	}
	.situation {
		display: inline-block;
		padding: 2px 8px;
		border-radius: var(--radius-sm, 4px);
		background: var(--accent-soft, #e6f0ff);
		font-size: 0.875rem;
		font-weight: 600;
	}
	.phrase-hide-bar {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-bottom: 8px;
	}
	.phrase-hide-bar[hidden] {
		display: none;
	}
	.hide-btn,
	.reveal {
		min-height: var(--touch-min, 44px);
		padding: 0 12px;
		border: 1px solid var(--border-strong, #7a8797);
		border-radius: var(--radius-md, 8px);
		background: var(--surface, #ffffff);
		color: var(--text, #17202b);
		font: inherit;
		font-size: 0.875rem;
		font-weight: 600;
		cursor: pointer;
	}
	.hide-btn[aria-pressed='true'] {
		background: var(--primary-soft, #e3eafb);
		border-color: var(--primary, #2447b8);
		color: var(--primary, #2447b8);
	}
	.hide-btn:focus-visible,
	.reveal:focus-visible {
		outline: 2px solid var(--focus, #2447b8);
		outline-offset: 2px;
	}
	.reveal {
		display: none;
		width: 100%;
		border-style: dashed;
		background: var(--surface-sunken, #eceff3);
		color: var(--text-muted, #556170);
		text-align: left;
	}
	:global(html[data-phrase-hide='foreign']) .row:not([lang='ko']):not([data-revealed]) .reveal,
	:global(html[data-phrase-hide='ko']) .row[lang='ko']:not([data-revealed]) .reveal {
		display: block;
	}
	:global(html[data-phrase-hide='foreign']) .row:not([lang='ko']):not([data-revealed]) .word,
	:global(html[data-phrase-hide='foreign']) .row:not([lang='ko']):not([data-revealed]) .reading,
	:global(html[data-phrase-hide='ko']) .row[lang='ko']:not([data-revealed]) .word {
		display: none;
	}
	.rows {
		display: flex;
		flex-direction: column;
	}
	.row {
		display: flex;
		gap: 12px;
		align-items: flex-start;
		padding: 8px 0;
		border-top: 1px solid var(--border, #d0d7de);
	}
	.label {
		flex: 0 0 72px;
		font-size: 0.8125rem;
		color: var(--muted, #57606a);
	}
	.text {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		gap: 2px;
		min-width: 0;
	}
	.speak {
		display: inline-flex;
		flex: 0 0 auto;
		align-items: center;
		justify-content: center;
		width: var(--touch-min, 44px);
		height: var(--touch-min, 44px);
		padding: 0;
		border: 1px solid var(--border-strong, #afb8c1);
		border-radius: var(--radius-full, 999px);
		background: var(--surface, #ffffff);
		color: var(--primary, #1f4fd8);
		cursor: pointer;
	}
	.speak[hidden] {
		display: none;
	}
	.speak:hover {
		background: var(--primary-soft, #e6edff);
	}
	.word {
		font-size: 1rem;
		line-height: 1.5;
	}
	.reading {
		font-size: 0.8125rem;
		color: var(--muted, #57606a);
		overflow-wrap: anywhere;
	}
	.reading[hidden] {
		display: none;
	}
	.reading-toggle {
		align-self: flex-start;
		min-height: var(--touch-min, 44px);
		padding: 0 8px;
		border: 0;
		background: none;
		color: var(--primary, #2447b8);
		font: inherit;
		font-size: 0.8125rem;
		font-weight: 600;
		text-decoration: underline;
		cursor: pointer;
	}
	.reading-toggle:focus-visible {
		outline: 2px solid var(--focus, #2447b8);
		outline-offset: 2px;
	}
	:global(html[data-phrase-hide='foreign']) .row:not([lang='ko']):not([data-revealed]) .reading-toggle {
		display: none;
	}
</style>
