---
import StepAnimation from './StepAnimation.astro';

interface Labels {
	group: string;
	titles: [string, string, string, string, string];
	captions: [string, string][];
	substrate: string;
	film: string;
	resist: string;
	mask: string;
	uv: string;
	exposed: string;
}

interface Props {
	labels?: Partial<Labels>;
	prevLabel?: string;
	nextLabel?: string;
}

const defaults: Labels = {
	group: '포토 공정 단면도',
	titles: ['1. 감광액 도포', '2. 노광', '3. 현상', '4. 식각', '5. 감광액 제거'],
	captions: [
		[
			'웨이퍼를 돌리며 감광액을 떨어뜨려 산화막 위에 얇고 고르게 입힙니다.',
			'막 두께가 고르지 않으면 빛을 받는 정도가 달라져 무늬가 흔들리기 때문입니다.',
		],
		[
			'마스크의 열린 자리를 지난 빛만 감광액에 닿아 그 부분의 성질을 바꿉니다.',
			'설계 무늬를 한 번에 감광액으로 옮기기 위해서입니다.',
		],
		[
			'현상액을 뿌려 빛을 받은 감광액만 녹여 내면 아래 산화막이 드러납니다.',
			'다음에 깎을 자리와 남길 자리를 나누기 위해서입니다.',
		],
		[
			'감광액이 덮지 않은 산화막만 깎아 냅니다.',
			'감광액의 무늬를 실제 막에 새기기 위해서입니다.',
		],
		[
			'가림막 역할을 마친 감광액을 벗겨 내면 무늬가 새겨진 산화막만 남습니다.',
			'다음 층을 올리려면 표면이 깨끗해야 하기 때문입니다.',
		],
	],
	substrate: '실리콘 기판',
	film: '산화막',
	resist: '감광액',
	mask: '마스크',
	uv: '자외선',
	exposed: '빛을 받은 영역',
};

const { labels, prevLabel, nextLabel } = Astro.props;
const t: Labels = { ...defaults, ...labels };

// 단면 좌표
const X0 = 60;
const X1 = 360;
const OPEN0 = 170;
const OPEN1 = 250;
const LABEL_X = 374;

const full = [[X0, X1 - X0]];
const patterned = [
	[X0, OPEN0 - X0],
	[OPEN1, X1 - OPEN1],
];

// 단계별 구성: resist/film = 'full' | 'patterned' | 'none'
const steps = [
	{ resist: 'full', film: 'full', expose: false },
	{ resist: 'full', film: 'full', expose: true },
	{ resist: 'patterned', film: 'full', expose: false },
	{ resist: 'patterned', film: 'patterned', expose: false },
	{ resist: 'none', film: 'patterned', expose: false },
];

const segments = (kind: string) => (kind === 'full' ? full : kind === 'patterned' ? patterned : []);
const uvXs = [80, 115, 150, 190, 210, 230, 270, 305, 340];
---

<StepAnimation label={t.group} prevLabel={prevLabel} nextLabel={nextLabel}>
	{
		steps.map((step, i) => (
			<figure>
			<svg class="photo-step" viewBox="0 30 480 232" role="img" aria-label={t.titles[i]}>
				{step.expose && (
					<g>
						<rect class="g-beam m-beam" x={X0} y="50" width={X1 - X0} height="26" />
						<rect class="g-beam m-beam" x={OPEN0} y="88" width={OPEN1 - OPEN0} height="28" />
						{uvXs.map((x) => {
							const through = x > OPEN0 && x < OPEN1;
							return (
								<g class="uv">
									<line class="m-flow" x1={x} y1="50" x2={x} y2={through ? 116 : 76} />
								</g>
							);
						})}
						<rect class="g-light m-glow" x={X0} y="40" width={X1 - X0} height="10" rx="5" />
						<rect class="mask" x={X0} y="76" width={OPEN0 - X0} height="12" rx="2" />
						<rect class="mask" x={OPEN1} y="76" width={X1 - OPEN1} height="12" rx="2" />
						<text x={LABEL_X} y="58">{t.uv}</text>
						<text x={LABEL_X} y="88">{t.mask}</text>
					</g>
				)}

				{segments(step.resist).map(([x, w]) => (
					<g>
						<rect class="resist" x={x} y="116" width={w} height="44" />
						<rect class="g-pr-hi" x={x} y="116" width={w} height="4" />
					</g>
				))}
				{step.expose && (
					<rect class="exposed m-fade" x={OPEN0 + 1} y="117" width={OPEN1 - OPEN0 - 2} height="42" />
				)}
				{segments(step.film).map(([x, w]) => (
					<g>
						<rect class="film" x={x} y="160" width={w} height="30" />
						<rect class="g-ox-hi" x={x} y="160" width={w} height="4" />
					</g>
				))}
				<rect class="substrate" x={X0} y="190" width={X1 - X0} height="44" />
				<rect class="g-si-lo" x={X0} y="222" width={X1 - X0} height="12" />

				{step.resist !== 'none' && <text x={LABEL_X} y="143">{t.resist}</text>}
				<text x={LABEL_X} y="180">{t.film}</text>
				<text x={LABEL_X} y="217">{t.substrate}</text>

				{step.expose && (
					<g>
						<rect class="exposed" x={X0} y="242" width="16" height="14" />
						<text x={X0 + 22} y="254">{t.exposed}</text>
					</g>
				)}
			</svg>
			<figcaption>
				<strong>{t.titles[i]}</strong>
				<p>{t.captions[i][0]}</p>
				<p>{t.captions[i][1]}</p>
			</figcaption>
			</figure>
		))
	}
</StepAnimation>

<style>
	.photo-step {
		max-width: 36rem;
		margin-inline: auto;
		font-family: var(--font-sans);
		font-size: 18px;
	}

	.photo-step text {
		fill: var(--color-text);
	}

	.photo-step .substrate {
		fill: var(--diagram-silicon);
	}

	.photo-step .film {
		fill: var(--diagram-oxide);
	}

	.photo-step .resist {
		fill: var(--diagram-resist);
	}

	.photo-step .exposed {
		fill: color-mix(in srgb, var(--diagram-resist) 35%, var(--color-bg));
		stroke: var(--diagram-resist);
		stroke-width: 2;
		stroke-dasharray: 4 3;
	}

	.photo-step .mask {
		fill: var(--diagram-stroke);
	}

	.photo-step .uv line {
		stroke: var(--diagram-light);
		stroke-width: 2;
	}

	.photo-step .uv polygon {
		fill: var(--diagram-light);
	}

	/* 좁은 화면: 그림이 줄어도 라벨이 14px 이상으로 보이게 */
	@media (max-width: 600px) {
		.photo-step {
			font-size: 22px;
		}
	}
</style>
