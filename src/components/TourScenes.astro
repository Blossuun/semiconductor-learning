			}
			<g class="a-grow" style="transform-origin:0 170px">
				<rect class="film" x="80" y="154" width="310" height="16" />
				<rect class="film-hi" x="80" y="154" width="310" height="4" />
			</g>
			<rect class="si" x="80" y="170" width="310" height="50" />
			<rect class="si-lo" x="80" y="206" width="310" height="14" />
			<text x="402" y="167">막</text>
			<text x="402" y="200">기판</text>
		</svg>
		<figcaption>
			<strong>3. {scenes[2].title}</strong>
			<p>{scenes[2].text}</p>
			<ul class="terms">{sceneTerms[2].map((t) => (<li><a href={`${base}/glossary/#term-${t.id}`}><span class="ko" lang="ko">{t.ko}</span>{t.en && <span data-lang="en" lang="en">{t.en}</span>}{t.ja && <span data-lang="ja" lang="ja">{t.ja}</span>}{t.zh_cn && <span data-lang="zh-Hans" lang="zh-Hans">{t.zh_cn}</span>}{t.zh_tw && <span data-lang="zh-Hant" lang="zh-Hant">{t.zh_tw}</span>}</a></li>))}</ul>
		</figcaption>
	</figure>

	<!-- 4. 빛으로 무늬 그리기 -->
	<figure class="scene">
		<svg viewBox="0 0 480 268" role="img" aria-label={scenes[3].title}>
			<rect class="beam a-beam" x="60" y="24" width="300" height="38" />
			<rect class="beam a-beam" x="170" y="74" width="80" height="58" />
			{
				uvXs.map((x) => {
					const end = x > 170 && x < 250 ? 132 : 62;
					return <line class="light-line a-flow" x1={x} y1="24" x2={x} y2={end} />;
				})
			}
			<rect class="light a-glow" x="60" y="12" width="300" height="12" rx="6" />
			<rect class="glass" x="56" y="59" width="308" height="4" />
			<rect class="mask" x="60" y="62" width="110" height="12" rx="2" />
			<rect class="mask" x="250" y="62" width="110" height="12" rx="2" />
			<rect class="pr" x="60" y="132" width="300" height="34" />
			<rect class="pr-hi" x="60" y="132" width="300" height="4" />
			<rect class="exposed a-expose" x="171" y="133" width="78" height="32" />
			<rect class="film" x="60" y="166" width="300" height="24" />
			<rect class="film-hi" x="60" y="166" width="300" height="4" />
			<rect class="si" x="60" y="190" width="300" height="40" />
			<rect class="si-lo" x="60" y="218" width="300" height="12" />
			<text x="374" y="38">빛</text>
			<text x="374" y="73">마스크</text>
			<text x="374" y="154">감광액</text>
			<text x="374" y="183">막</text>
			<text x="374" y="215">기판</text>
		</svg>
		<figcaption>
			<strong>4. {scenes[3].title}</strong>
			<p>{scenes[3].text}</p>
			<ul class="terms">{sceneTerms[3].map((t) => (<li><a href={`${base}/glossary/#term-${t.id}`}><span class="ko" lang="ko">{t.ko}</span>{t.en && <span data-lang="en" lang="en">{t.en}</span>}{t.ja && <span data-lang="ja" lang="ja">{t.ja}</span>}{t.zh_cn && <span data-lang="zh-Hans" lang="zh-Hans">{t.zh_cn}</span>}{t.zh_tw && <span data-lang="zh-Hant" lang="zh-Hant">{t.zh_tw}</span>}</a></li>))}</ul>
		</figcaption>
	</figure>

	<!-- 5. 깎아 내기 -->
	<figure class="scene">
		<svg viewBox="0 0 480 268" role="img" aria-label={scenes[4].title}>
			<rect class="beam a-beam" x="30" y="40" width="190" height="14" rx="7" />
			<circle class="light a-ion" cx="112" cy="66" r="3.5" />
			<circle class="light a-ion" cx="125" cy="66" r="3.5" style="animation-delay:0.4s" />
			<circle class="light a-ion" cx="138" cy="66" r="3.5" style="animation-delay:0.8s" />
			<rect class="pr" x="30" y="100" width="70" height="34" />
			<rect class="pr" x="150" y="100" width="70" height="34" />
			<rect class="pr-hi" x="30" y="100" width="70" height="4" />
			<rect class="pr-hi" x="150" y="100" width="70" height="4" />
			<rect class="film" x="30" y="134" width="70" height="30" />
			<rect class="film" x="150" y="134" width="70" height="30" />
			<rect class="film etch-gap a-etch" x="100" y="134" width="50" height="30" style="transform-origin:0 164px" />
			<rect class="si" x="30" y="164" width="190" height="40" />
			<rect class="si-lo" x="30" y="192" width="190" height="12" />
			<text x="125" y="232" text-anchor="middle">깎아 내기</text>

			<path class="arrow" d="M226 150 h22 m-8 -7 l8 7 l-8 7" />

			<rect class="pr strip a-strip" x="260" y="100" width="70" height="34" />
			<rect class="pr strip a-strip" x="380" y="100" width="70" height="34" />
			<rect class="film" x="260" y="134" width="70" height="30" />
			<rect class="film" x="380" y="134" width="70" height="30" />
			<rect class="film-hi" x="260" y="134" width="70" height="4" />
			<rect class="film-hi" x="380" y="134" width="70" height="4" />
			<rect class="si" x="260" y="164" width="190" height="40" />
			<rect class="si-lo" x="260" y="192" width="190" height="12" />
			<text x="355" y="232" text-anchor="middle">감광액을 벗긴 뒤</text>
		</svg>
		<figcaption>
			<strong>5. {scenes[4].title}</strong>
			<p>{scenes[4].text}</p>
			<ul class="terms">{sceneTerms[4].map((t) => (<li><a href={`${base}/glossary/#term-${t.id}`}><span class="ko" lang="ko">{t.ko}</span>{t.en && <span data-lang="en" lang="en">{t.en}</span>}{t.ja && <span data-lang="ja" lang="ja">{t.ja}</span>}{t.zh_cn && <span data-lang="zh-Hans" lang="zh-Hans">{t.zh_cn}</span>}{t.zh_tw && <span data-lang="zh-Hant" lang="zh-Hant">{t.zh_tw}</span>}</a></li>))}</ul>
		</figcaption>
	</figure>

	<!-- 6. 성질 바꾸고 전기 길 놓기 -->
	<figure class="scene">
		<svg viewBox="0 0 480 268" role="img" aria-label={scenes[5].title}>
			<rect class="insulator" x="60" y="80" width="280" height="110" rx="4" />
			<rect class="si" x="60" y="190" width="280" height="46" />
			<rect class="si-lo" x="60" y="224" width="280" height="12" />

			<path class="doped" d="M100 190 H160 V202 a6 6 0 0 1 -6 6 H106 a6 6 0 0 1 -6 -6 Z" />
			<path class="doped" d="M230 190 H290 V202 a6 6 0 0 1 -6 6 H236 a6 6 0 0 1 -6 -6 Z" />
			<circle class="dopant a-twinkle" cx="115" cy="199" r="3" />
			<circle class="dopant a-twinkle" cx="130" cy="199" r="3" style="animation-delay:0.4s" />
			<circle class="dopant a-twinkle" cx="145" cy="199" r="3" style="animation-delay:0.8s" />
			<circle class="dopant a-twinkle" cx="245" cy="199" r="3" style="animation-delay:0.2s" />
			<circle class="dopant a-twinkle" cx="260" cy="199" r="3" style="animation-delay:0.6s" />
			<circle class="dopant a-twinkle" cx="275" cy="199" r="3" style="animation-delay:1s" />

			<rect class="metal" x="125" y="152" width="10" height="38" />
			<rect class="metal" x="255" y="152" width="10" height="38" />
			<rect class="metal" x="110" y="142" width="80" height="10" rx="2" />
			<rect class="metal" x="240" y="142" width="80" height="10" rx="2" />
			<rect class="metal" x="175" y="112" width="10" height="30" />
			<rect class="metal" x="300" y="112" width="10" height="30" />
			<rect class="metal" x="160" y="102" width="165" height="10" rx="2" />
			<rect class="metal-hi" x="112" y="142" width="76" height="3" />
