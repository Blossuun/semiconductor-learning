</StepAnimation>

<style>
	.scene {
		--si: var(--diagram-silicon);
		--si-hi: color-mix(in srgb, var(--diagram-silicon) 62%, white);
		--si-lo: color-mix(in srgb, var(--diagram-silicon) 72%, black);
		--oxide-hi: color-mix(in srgb, var(--diagram-oxide) 60%, white);
		--resist-hi: color-mix(in srgb, var(--diagram-resist) 65%, white);
		--copper-hi: color-mix(in srgb, var(--diagram-copper) 50%, white);
		--sand-lo: color-mix(in srgb, var(--diagram-sand) 78%, black);
	}

	.scene svg {
		display: block;
		width: 100%;
		max-width: 21rem;
		height: auto;
		margin-inline: auto;
		font-family: var(--font-sans);
		font-size: 18px;
	}

	figcaption {
		max-width: 36rem;
		margin: var(--space-2) auto 0;
	}

	figcaption p {
		margin: var(--space-1) 0 0;
	}

	text {
		fill: var(--color-text);
	}

	.ground {
		fill: var(--diagram-stroke);
		fill-opacity: 0.1;
	}

	.si {
		fill: var(--si);
	}

	.si-hi {
		fill: var(--si-hi);
	}

	.si-lo {
		fill: var(--si-lo);
	}

	.film {
		fill: var(--diagram-oxide);
	}

	.film-hi {
		fill: var(--oxide-hi);
	}

	.pr {
		fill: var(--diagram-resist);
	}

	.pr-hi {
		fill: var(--resist-hi);
	}

	.exposed {
		fill: color-mix(in srgb, var(--diagram-resist) 35%, var(--color-bg));
		stroke: var(--diagram-resist);
		stroke-width: 2;
		stroke-dasharray: 4 3;
	}

	.mask,
	.solid {
		fill: var(--diagram-stroke);
	}

	.glass {
		fill: var(--diagram-stroke);
		fill-opacity: 0.25;
	}

	.light {
		fill: var(--diagram-light);
	}

	.beam {
		fill: var(--diagram-light);
		fill-opacity: 0.2;
	}

	.light-line {
		stroke: var(--diagram-light);
		stroke-width: 2;
		stroke-dasharray: 7 6;
		stroke-linecap: round;
	}

	.metal {
		fill: var(--diagram-copper);
	}

	.metal-hi {
		fill: var(--copper-hi);
	}

	.sand {
		fill: var(--diagram-sand);
	}

	.sand-lo {
		fill: var(--sand-lo);
	}

	.grain {
		fill: var(--color-bg);
	}

	.molten {
		fill: var(--diagram-copper);
	}

	.molten-hi {
		fill: var(--diagram-sand);
	}

	.heatwave {
		fill: none;
		stroke: var(--diagram-copper);
		stroke-width: 2.5;
		stroke-linecap: round;
	}

	.sparkle,
	.sheen {
		fill: #fff;
		fill-opacity: 0.85;
	}

	.sheen {
		fill-opacity: 0.4;
	}

	.thin,
	.outline {
		fill: none;
		stroke: var(--diagram-stroke);
		stroke-width: 2;
		stroke-linecap: round;
	}

	.arrow {
		fill: none;
		stroke: var(--diagram-stroke);
		stroke-opacity: 0.55;
		stroke-width: 2.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.insulator {
		fill: var(--diagram-oxide);
		fill-opacity: 0.28;
	}

	.doped {
		fill: color-mix(in srgb, var(--diagram-sand) 55%, var(--si));
	}

	.dopant {
		fill: var(--color-bg);
	}

	.signal {
		fill: none;
		stroke: #fff;
		stroke-width: 4;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-dasharray: 16 420;
		opacity: 0;
	}

	.notch {
		fill: var(--surface-sunken);
	}

	.die {
		fill: var(--diagram-oxide);
		stroke: var(--si-lo);
		stroke-width: 1;
	}

	.die-fail {
		fill: var(--diagram-resist);
	}

	.fail-mark {
		fill: #fff;
		font-size: 16px;
		font-weight: 700;
	}

	.chip-body {
		fill: var(--si-lo);
	}

	.chip-core {
		fill: var(--diagram-oxide);
	}

	.chip-line {
		fill: none;
		stroke: var(--oxide-hi);
		stroke-width: 2;
		stroke-linecap: round;
	}

	.mold {
		fill: var(--si-lo);
	}

	.package {
		fill: var(--si);
	}

	.pin {
		fill: var(--si-hi);
	}

	.phone {
		fill: var(--color-bg);
		stroke: var(--diagram-stroke);
		stroke-width: 2;
	}

	.screen {
		fill: var(--diagram-oxide);
		fill-opacity: 0.22;
	}

	.ping {
		fill: none;
		stroke: var(--diagram-light);
		stroke-width: 2;
		opacity: 0;
	}

	.etch-gap {
		transform: scaleY(0);
	}

	.strip {
		opacity: 0;
	}

	/* 모션 */
	.a-twinkle {
		animation: tour-twinkle 2.4s ease-in-out infinite;
	}

	.a-sparkle {
		animation: tour-sparkle 2.6s ease-in-out infinite;
	}

	.a-rise {
		animation: tour-rise 2.1s ease-out infinite;
	}

	.a-glow {
		animation: tour-glow 2s ease-in-out infinite;
	}

	.a-bubble {
		animation: tour-bubble 1.8s ease-in infinite;
	}

	.a-pull {
		animation: tour-pull 4s ease-in-out infinite;
	}

	.a-spread {
		animation: tour-spread 3.2s ease-in-out infinite;
	}

	.a-sheen {
		animation: tour-sheen 3.6s ease-in-out infinite;
	}

	.a-fall {
		animation: tour-fall 1.8s ease-in infinite backwards;
	}

	.a-grow {
		animation: tour-grow 6s ease-out infinite;
	}

	.a-beam {
		animation: tour-beam 2s ease-in-out infinite;
	}

	.a-flow {
		animation: tour-flow 0.9s linear infinite;
	}

	.a-expose {
		animation: tour-expose 5s ease-in-out infinite;
	}

	.a-ion {
		animation: tour-ion 1.2s ease-in infinite backwards;
	}

	.a-etch {
		animation: tour-etch 5s linear infinite;
	}

	.a-strip {
		animation: tour-strip 5s ease-in infinite;
	}

	.a-signal {
		animation: tour-signal 3s linear infinite;
	}

	.a-spin {
		animation: tour-spin 6s linear infinite;
	}

	.a-scan {
		animation: tour-scan 6s ease-out infinite backwards;
	}

	.a-float {
		animation: tour-float 3s ease-in-out infinite;
	}

	.a-shadow {
		animation: tour-shadow 3s ease-in-out infinite;
	}

	.a-drop {
		animation: tour-drop 6s ease-out infinite;
	}

	.a-mold {
		animation: tour-mold 6s ease-out infinite;
	}

	.a-ping {
		animation: tour-ping 2s ease-out infinite;
	}

	@keyframes tour-twinkle {
		0%,
		100% {
			opacity: 1;
		}
		50% {
			opacity: 0.3;
		}
	}

	@keyframes tour-sparkle {
		0%,
		100% {
			transform: scale(0.5) rotate(0deg);
			opacity: 0.2;
		}
		50% {
			transform: scale(1.1) rotate(45deg);
			opacity: 1;
		}
	}

	@keyframes tour-rise {
		0% {
			transform: translateY(8px);
			opacity: 0;
		}
		40% {
			opacity: 0.9;
		}
		100% {
			transform: translateY(-10px);
			opacity: 0;
		}
	}

	@keyframes tour-glow {
		0%,
		100% {
			filter: brightness(1);
		}
		50% {
			filter: brightness(1.25);
		}
	}

	@keyframes tour-bubble {
		0% {
			transform: translateY(0);
			opacity: 0;
		}
		20% {
			opacity: 1;
		}
		100% {
			transform: translateY(-30px);
			opacity: 0;
		}
	}

	@keyframes tour-pull {
		0%,
		100% {
			transform: translateY(5px);
		}
		50% {
			transform: translateY(-5px);
		}
	}

	@keyframes tour-spread {
		0%,
		20%,
		100% {
			transform: translateX(0);
		}
		55%,
		80% {
			transform: translateX(var(--dx));
		}
	}

	@keyframes tour-sheen {
		0%,
		30% {
			transform: translateX(-20px);
		}
		80%,
		100% {
			transform: translateX(150px);
		}
	}

	@keyframes tour-fall {
		0% {
			transform: translateY(-8px);
			opacity: 0;
		}
		15% {
			opacity: 1;
		}
		85% {
			opacity: 1;
		}
		100% {
			transform: translateY(86px);
			opacity: 0;
		}
	}

	@keyframes tour-grow {
		0% {
			transform: scaleY(0.1);
		}
		70%,
		100% {
			transform: scaleY(1);
		}
	}

	@keyframes tour-beam {
		0%,
		100% {
			fill-opacity: 0.14;
		}
		50% {
			fill-opacity: 0.3;
		}
	}

	@keyframes tour-flow {
		to {
			stroke-dashoffset: -13;
		}
	}

	@keyframes tour-expose {
		0%,
		15% {
			opacity: 0;
		}
		60%,
		100% {
			opacity: 1;
		}
	}

	@keyframes tour-ion {
		0% {
			transform: translateY(-6px);
			opacity: 0;
		}
		20% {
			opacity: 1;
		}
		100% {
			transform: translateY(92px);
			opacity: 0;
		}
	}

	@keyframes tour-etch {
		0%,
		10% {
			transform: scaleY(1);
		}
		65%,
		100% {
			transform: scaleY(0);
		}
	}

	@keyframes tour-strip {
		0%,
		20% {
			transform: translateY(0);
			opacity: 1;
		}
		65%,
		100% {
			transform: translateY(-22px);
			opacity: 0;
		}
	}

	@keyframes tour-signal {
		0% {
			stroke-dashoffset: 16;
			opacity: 0.9;
		}
		90% {
			opacity: 0.9;
		}
		100% {
			stroke-dashoffset: -390;
			opacity: 0;
		}
	}

	@keyframes tour-spin {
		to {
			transform: rotate(-360deg);
		}
	}

	@keyframes tour-scan {
		0% {
			opacity: 0.25;
		}
		6%,
		100% {
			opacity: 1;
		}
	}

	@keyframes tour-float {
		0%,
		100% {
			transform: translateY(4px);
		}
		50% {
			transform: translateY(-4px);
		}
	}

	@keyframes tour-shadow {
		0%,
		100% {
			transform: scaleX(1);
		}
		50% {
			transform: scaleX(0.8);
		}
	}

	@keyframes tour-drop {
		0% {
			transform: translateY(-44px);
			opacity: 0;
		}
		10% {
			opacity: 1;
		}
		35%,
		100% {
			transform: translateY(0);
			opacity: 1;
		}
	}

	@keyframes tour-mold {
		0%,
		38% {
			opacity: 0;
		}
		55%,
		100% {
			opacity: 1;
		}
	}

	@keyframes tour-ping {
		0% {
			transform: scale(0.8);
			opacity: 0.9;
		}
		100% {
			transform: scale(2.2);
			opacity: 0;
		}
	}

	/* 보이지 않는 장면은 멈춰 두고, 다시 열리면 처음부터 재생 */
	:global(.step-animation[data-ready]) .scene:not([data-active]) svg * {
		animation: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.scene svg * {
			animation: none;
		}
	}

	.terms {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
