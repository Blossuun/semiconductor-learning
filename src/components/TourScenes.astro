---
import { getEntry } from 'astro:content';
import StepAnimation from './StepAnimation.astro';

// 장면 문구: docs/tour-scenes.md
const scenes = [
	{
		title: '모래에서 실리콘으로',
		text: '칩의 재료는 모래에 많이 들어 있는 실리콘입니다. 모래를 녹이고 불순물을 걸러 내 아주 순수한 실리콘을 얻습니다. 회로를 그릴 바탕이 깨끗하지 않으면 전기가 엉뚱하게 흘러 칩이 제대로 동작하지 않습니다.',
	},
	{
		title: '기둥을 만들고 얇게 자르기',
		text: '녹인 실리콘을 천천히 끌어올려 둥근 기둥(잉곳)으로 굳힙니다. 이 기둥을 얇게 잘라 거울처럼 닦은 원판이 웨이퍼입니다. 한 장의 원판 위에 칩을 여러 개 만들어야 하므로, 넓고 평평한 판이 필요합니다.',
	},
	{
		title: '막 입히기',
		text: '웨이퍼 위에 얇은 막을 고르게 입힙니다. 이 막이 나중에 회로의 재료가 됩니다. 회로는 얇은 층을 여러 겹 쌓아 만들어지므로, 먼저 층을 깔아 두어야 합니다.',
	},
	{
		title: '빛으로 무늬 그리기',
		text: '막 위에 빛에 반응하는 감광액을 바르고, 회로 무늬가 그려진 마스크를 통해 빛을 비춥니다. 빛을 받은 자리만 씻겨 나가 무늬가 남습니다. 깎을 자리를 미리 정해 두지 않으면 원하는 곳만 남기고 깎을 수 없기 때문입니다.',
	},
	{
		title: '깎아 내기',
		text: '감광액이 가리지 않은 부분의 막을 깎아 냅니다. 감광액을 벗기면 막에 회로 무늬가 그대로 새겨져 있습니다. 필요 없는 막이 남아 있으면 전기가 엉뚱한 길로 새기 때문에 깎아 냅니다.',
	},
	{
		title: '성질 바꾸고 전기 길 놓기',
		text: '실리콘에 다른 원자를 넣어 전기가 흐르는 성질을 바꾸고, 금속으로 전기가 다닐 길을 잇습니다. 3~5 장면을 수백 번 되풀이하며 층을 쌓아 올립니다. 실리콘만으로는 전기를 원하는 만큼 조절할 수 없어서, 성질을 바꾼 자리와 전선이 함께 있어야 회로가 동작합니다.',
	},
	{
		title: '검사하고 낱개로 자르기',
		text: '웨이퍼 한 장에는 같은 칩이 수백 개 들어 있습니다. 하나씩 전기를 흘려 검사한 뒤 낱개로 잘라 냅니다. 불량 칩을 미리 가려내야 그 칩에 포장 비용을 들이지 않습니다.',
	},
	{
		title: '포장해서 완성',
		text: '잘라 낸 칩을 기판에 붙여 바깥과 전기로 잇고 단단한 재료로 감쌉니다. 이제 휴대폰과 컴퓨터에 들어갈 반도체가 완성됐습니다. 칩은 얇고 약해 그대로 쓰면 쉽게 깨지고 바깥 기기와 이을 수 없어서, 이 포장이 꼭 필요합니다.',
	},
];

// 장면별 핵심 용어 id (glossary.yaml). 용어 표기는 여기서 가져온다.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sceneTermIds = [
	['silicon'],
	['ingot', 'wafer'],
	['oxidation', 'deposition'],
	['photolithography', 'photoresist'],
	['etching'],
	['ion-implantation', 'metallization'],
	['eds', 'dicing'],
	['packaging'],
];
const sceneTerms = await Promise.all(
	sceneTermIds.map((ids) =>
		Promise.all(
			ids.map(async (id) => {
				const entry = await getEntry('glossary', id);
				if (!entry) {
					throw new Error(`TourScenes: glossary.yaml에 id "${id}" 용어가 없습니다.`);
				}
				return { id, ...entry.data };
			}),
		),
	),
);

// 장면 7: 원 안에 들어가는 칩 격자
const dies: { x: number; y: number }[] = [];
const WAFER = { cx: 150, cy: 122, r: 95 };
const DIE = 22;
const PITCH = 26;
for (let row = -4; row <= 3; row++) {
	for (let col = -4; col <= 3; col++) {
		const x = WAFER.cx + col * PITCH + 2;
		const y = WAFER.cy + row * PITCH + 2;
		const corners = [
			[x, y],
			[x + DIE, y],
			[x, y + DIE],
			[x + DIE, y + DIE],
		];
		if (corners.every(([px, py]) => Math.hypot(px - WAFER.cx, py - WAFER.cy) <= WAFER.r - 5)) {
			dies.push({ x, y });
		}
	}
}
const failed = new Set([3, 17, 26]);


const particles = [130, 170, 210, 250, 290, 330];
const uvXs = [80, 115, 150, 190, 210, 230, 270, 305, 340];
const slices = [0, 1, 2, 3, 4];
const balls = [62, 101, 140, 179, 218];
const bumps = [95, 118, 140, 162, 185];
const pads = [337, 351, 365, 379];
---

<StepAnimation label="칩 하나 만들어 보기 투어">
	<!-- 1. 모래에서 실리콘으로 -->
	<figure class="scene">
		<svg viewBox="0 0 480 268" role="img" aria-label={scenes[0].title}>
			<ellipse class="ground" cx="95" cy="207" rx="80" ry="6" />
			<path class="sand" d="M22 206 C58 204 70 128 95 128 C120 128 132 204 168 206 Z" />
			<path class="sand-lo" d="M95 128 C120 128 132 204 168 206 H112 C116 172 106 142 95 128 Z" />
			<circle class="grain a-twinkle" cx="70" cy="186" r="2.2" />
			<circle class="grain a-twinkle" cx="86" cy="160" r="2.2" style="animation-delay:0.5s" />
			<circle class="grain a-twinkle" cx="92" cy="194" r="2.2" style="animation-delay:1.1s" />
			<circle class="grain a-twinkle" cx="56" cy="198" r="2.2" style="animation-delay:1.6s" />
			<circle class="grain a-twinkle" cx="82" cy="178" r="2.2" style="animation-delay:0.8s" />
			<text x="95" y="232" text-anchor="middle">모래</text>

			<path class="arrow" d="M176 165 h28 m-8 -7 l8 7 l-8 7" />

			<ellipse class="ground" cx="260" cy="207" rx="54" ry="6" />
			<path class="heatwave a-rise" d="M240 100 q6 -8 0 -16 q-6 -8 0 -16" />
			<path class="heatwave a-rise" d="M260 100 q6 -8 0 -16 q-6 -8 0 -16" style="animation-delay:0.7s" />
			<path class="heatwave a-rise" d="M280 100 q6 -8 0 -16 q-6 -8 0 -16" style="animation-delay:1.4s" />
			<rect class="si-lo" x="216" y="110" width="88" height="96" rx="10" />
			<rect class="si" x="216" y="110" width="88" height="16" rx="8" />
			<rect class="molten a-glow" x="230" y="138" width="60" height="52" rx="8" />
			<circle class="molten-hi a-bubble" cx="245" cy="180" r="3.5" />
			<circle class="molten-hi a-bubble" cx="262" cy="182" r="3" style="animation-delay:0.6s" />
			<circle class="molten-hi a-bubble" cx="277" cy="179" r="3.5" style="animation-delay:1.2s" />
			<text x="260" y="232" text-anchor="middle">녹이기</text>

			<path class="arrow" d="M316 165 h28 m-8 -7 l8 7 l-8 7" />

			<ellipse class="ground" cx="408" cy="207" rx="52" ry="6" />
			<polygon class="si" points="366,205 378,152 410,172 400,205" />
			<polygon class="si-hi" points="378,152 416,130 452,160 410,172" />
			<polygon class="si-lo" points="410,172 452,160 446,205 400,205" />
			<path
				class="sparkle a-sparkle"
				style="transform-origin:436px 136px"
				d="M436 124 l3 9 l9 3 l-9 3 l-3 9 l-3 -9 l-9 -3 l9 -3 Z"
			/>
			<text x="408" y="232" text-anchor="middle">실리콘</text>
		</svg>
		<figcaption>
			<strong>1. {scenes[0].title}</strong>
			<p>{scenes[0].text}</p>
			<ul class="terms">{sceneTerms[0].map((t) => (<li><a href={`${base}/glossary/#term-${t.id}`}><span class="ko" lang="ko">{t.ko}</span>{t.en && <span data-lang="en" lang="en">{t.en}</span>}{t.ja && <span data-lang="ja" lang="ja">{t.ja}</span>}{t.zh_cn && <span data-lang="zh-Hans" lang="zh-Hans">{t.zh_cn}</span>}{t.zh_tw && <span data-lang="zh-Hant" lang="zh-Hant">{t.zh_tw}</span>}</a></li>))}</ul>
		</figcaption>
	</figure>

	<!-- 2. 기둥을 만들고 얇게 자르기 -->
	<figure class="scene">
		<svg viewBox="0 0 480 268" role="img" aria-label={scenes[1].title}>
			<ellipse class="ground" cx="90" cy="207" rx="40" ry="5" />
			<g class="a-pull">
				<path class="thin" d="M90 14 V42" />
				<polygon class="si-hi" points="90,40 62,82 90,82" />
				<polygon class="si" points="90,40 118,82 90,82" />
				<rect class="si" x="62" y="82" width="56" height="108" />
				<ellipse class="si" cx="90" cy="190" rx="28" ry="7" />
				<rect class="si-hi" x="68" y="82" width="8" height="108" />
				<path class="si-lo" d="M104 82 H118 V190 A28 7 0 0 1 104 196 Z" />
			</g>
			<text x="90" y="232" text-anchor="middle">잉곳</text>

			<path class="arrow" d="M134 140 h28 m-8 -7 l8 7 l-8 7" />

			<ellipse class="ground" cx="240" cy="184" rx="62" ry="5" />
			{
				slices.map((i) => {
					const x = 190 + i * 22;
					return (
						<g class="a-spread" style={`--dx:${(i - 2) * 4}px`}>
							<rect class="si" x={x} y="110" width="18" height="60" />
							<ellipse class="si-lo" cx={x + 18} cy="140" rx="6" ry="30" />
							<ellipse class="si-hi" cx={x} cy="140" rx="6" ry="30" />
						</g>
					);
				})
			}

			<path class="arrow" d="M312 140 h24 m-8 -7 l8 7 l-8 7" />

			<ellipse class="ground" cx="408" cy="190" rx="52" ry="5" />
			<ellipse class="si-lo" cx="408" cy="150" rx="60" ry="22" />
			<ellipse class="si" cx="408" cy="144" rx="60" ry="22" />
			<clipPath id="tour-wafer-clip">
				<ellipse cx="408" cy="144" rx="60" ry="22" />
			</clipPath>
			<g clip-path="url(#tour-wafer-clip)">
				<polygon class="sheen a-sheen" points="340,170 356,170 376,118 360,118" />
				<polygon class="sheen a-sheen" points="364,170 370,170 390,118 384,118" />
			</g>
			<text x="408" y="232" text-anchor="middle">웨이퍼</text>
		</svg>
		<figcaption>
			<strong>2. {scenes[1].title}</strong>
			<p>{scenes[1].text}</p>
			<ul class="terms">{sceneTerms[1].map((t) => (<li><a href={`${base}/glossary/#term-${t.id}`}><span class="ko" lang="ko">{t.ko}</span>{t.en && <span data-lang="en" lang="en">{t.en}</span>}{t.ja && <span data-lang="ja" lang="ja">{t.ja}</span>}{t.zh_cn && <span data-lang="zh-Hans" lang="zh-Hans">{t.zh_cn}</span>}{t.zh_tw && <span data-lang="zh-Hant" lang="zh-Hant">{t.zh_tw}</span>}</a></li>))}</ul>
		</figcaption>
	</figure>

	<!-- 3. 막 입히기 -->
	<figure class="scene">
		<svg viewBox="0 0 480 268" role="img" aria-label={scenes[2].title}>
			<rect class="si-lo" x="100" y="26" width="270" height="18" rx="5" />
			<rect class="si" x="100" y="26" width="270" height="6" rx="3" />
			{
				particles.map((x, i) => (
					<g>
						<rect class="si-lo" x={x - 5} y="44" width="10" height="7" />
						<circle class="film a-fall" cx={x} cy="64" r="5" style={`animation-delay:${(i % 3) * 0.5 + (i % 2) * 0.25}s`} />
						<circle class="film a-fall" cx={x} cy="64" r="3.5" style={`animation-delay:${(i % 3) * 0.5 + (i % 2) * 0.25 + 0.9}s`} />
