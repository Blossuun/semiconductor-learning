---
interface Props {
	label?: string;
	prevLabel?: string;
	nextLabel?: string;
}

const { label = '단계별 도해', prevLabel = '이전', nextLabel = '다음' } = Astro.props;
---

<div class="step-animation" role="group" aria-label={label} data-step-animation>
	<div class="steps" data-steps>
		<slot />
	</div>
	<div class="controls">
		<button type="button" data-prev>{prevLabel}</button>
		<div class="progress">
			<span class="dots" aria-hidden="true" data-dots></span>
			<span class="counter" aria-live="polite" data-counter></span>
		</div>
		<button type="button" data-next>{nextLabel}</button>
	</div>
</div>

<script>
	document.querySelectorAll<HTMLElement>('[data-step-animation]').forEach((root) => {
		const steps = Array.from(root.querySelector('[data-steps]')!.children) as HTMLElement[];
		const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
		const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
		const counter = root.querySelector<HTMLElement>('[data-counter]')!;
		const dotsBox = root.querySelector<HTMLElement>('[data-dots]')!;
		if (steps.length === 0) return;

		const dots = steps.map(() => {
			const dot = document.createElement('span');
			dot.className = 'dot';
			dotsBox.appendChild(dot);
			return dot;
		});

		let index = 0;

		const show = (target: number) => {
			index = Math.max(0, Math.min(steps.length - 1, target));
			steps.forEach((step, i) => {
				step.toggleAttribute('data-active', i === index);
				step.setAttribute('aria-hidden', String(i !== index));
			});
			dots.forEach((dot, i) => dot.toggleAttribute('data-active', i === index));
			// disabled 속성은 초점을 잃게 하므로 aria-disabled로 표시한다
			prev.setAttribute('aria-disabled', String(index === 0));
			next.setAttribute('aria-disabled', String(index === steps.length - 1));
			counter.textContent = `${index + 1} / ${steps.length}`;
			// 화면 낭독기에는 장면 제목도 함께 알린다
			const title =
				steps[index].getAttribute('aria-label') ??
				steps[index].querySelector('[aria-label]')?.getAttribute('aria-label');
			if (title) {
				const spoken = document.createElement('span');
				spoken.textContent = ` ${title}`;
				spoken.style.cssText =
					'position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap';
				counter.appendChild(spoken);
			}
		};

		prev.addEventListener('click', () => {
			if (index > 0) show(index - 1);
		});
		next.addEventListener('click', () => {
			if (index < steps.length - 1) show(index + 1);
		});
		root.addEventListener('keydown', (event) => {
			if (event.key === 'ArrowLeft') show(index - 1);
			if (event.key === 'ArrowRight') show(index + 1);
		});

		show(0);
		root.setAttribute('data-ready', '');
	});
</script>

<style>
	.step-animation {
		margin: var(--space-4) 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		overflow: hidden;
	}

	.steps {
		display: grid;
		gap: var(--space-3);
		padding: var(--space-3);
		background: var(--surface-sunken);
	}

	/* 휴대폰: 도해가 최대한 넓게 보이도록 여백을 줄여 그림 속 글자 축소를 막는다 */
	@media (max-width: 480px) {
		.step-animation {
			border-radius: var(--radius-md);
		}

		.steps {
			padding: var(--space-1);
		}
	}

	.steps > :global(*) {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
	}

	.step-animation[data-ready] .steps > :global(*) {
		grid-area: 1 / 1;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 0.2s ease,
			visibility 0.2s;
	}

	.step-animation[data-ready] .steps > :global([data-active]) {
		opacity: 1;
		visibility: visible;
	}

	.controls {
		display: none;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		padding: var(--space-2) var(--space-3);
		border-top: 1px solid var(--border);
	}

	.step-animation[data-ready] .controls {
		display: flex;
	}

	.progress {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-1);
		min-width: 0;
	}

	.dots {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		flex-wrap: wrap;
		justify-content: center;
	}

	.dot {
		width: 8px;
		height: 8px;
		border-radius: var(--radius-full);
		background: var(--border-strong);
	}

	.dot[data-active] {
		background: var(--primary);
	}

	.counter {
		color: var(--text-muted);
		font-family: var(--font-mono);
		font-size: var(--fs-mono);
		line-height: var(--lh-mono);
		font-weight: 500;
		font-variant-numeric: tabular-nums;
		text-align: center;
	}

	button {
		min-height: var(--touch-min);
		min-width: var(--touch-min);
		padding: var(--space-2) var(--space-4);
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-md);
		background: var(--surface);
		color: var(--text);
		font: inherit;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
		cursor: pointer;
	}

	button:hover:not(:disabled) {
		border-color: var(--primary);
		color: var(--primary);
	}

	button:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
	}

	button:disabled,
	button[aria-disabled='true'] {
		color: var(--text-muted);
		opacity: 0.5;
		cursor: default;
	}

	@media (prefers-reduced-motion: reduce) {
		.step-animation[data-ready] .steps > :global(*) {
			transition: none;
		}
	}
</style>

<!-- 레슨 도해 공용: 색면(g-), 선(s-), 글자(t-), 모션(m-). 모션은 --d(지연), --t(길이), --dx/--dy(이동)로 조절 -->
<style is:global>
	.step-animation svg {
		--g-si-hi: color-mix(in srgb, var(--diagram-silicon) 62%, white);
		--g-si-lo: color-mix(in srgb, var(--diagram-silicon) 72%, black);
		--g-ox-hi: color-mix(in srgb, var(--diagram-oxide) 58%, white);
		--g-ox-lo: color-mix(in srgb, var(--diagram-oxide) 72%, black);
		--g-pr-hi: color-mix(in srgb, var(--diagram-resist) 62%, white);
		--g-cu-hi: color-mix(in srgb, var(--diagram-copper) 50%, white);
		--g-cu-lo: color-mix(in srgb, var(--diagram-copper) 72%, black);
		--g-sand-hi: color-mix(in srgb, var(--diagram-sand) 55%, white);
		--g-sand-lo: color-mix(in srgb, var(--diagram-sand) 76%, black);
		--g-light-hi: color-mix(in srgb, var(--diagram-light) 55%, white);
	}

	.step-animation svg .g-si { fill: var(--diagram-silicon); }
	.step-animation svg .g-si-hi { fill: var(--g-si-hi); }
	.step-animation svg .g-si-lo { fill: var(--g-si-lo); }
	.step-animation svg .g-ox { fill: var(--diagram-oxide); }
	.step-animation svg .g-ox-hi { fill: var(--g-ox-hi); }
	.step-animation svg .g-ox-lo { fill: var(--g-ox-lo); }
	.step-animation svg .g-pr { fill: var(--diagram-resist); }
	.step-animation svg .g-pr-hi { fill: var(--g-pr-hi); }
	.step-animation svg .g-cu { fill: var(--diagram-copper); }
	.step-animation svg .g-cu-hi { fill: var(--g-cu-hi); }
	.step-animation svg .g-cu-lo { fill: var(--g-cu-lo); }
	.step-animation svg .g-sand { fill: var(--diagram-sand); }
	.step-animation svg .g-sand-hi { fill: var(--g-sand-hi); }
	.step-animation svg .g-sand-lo { fill: var(--g-sand-lo); }
	.step-animation svg .g-light { fill: var(--diagram-light); }
	.step-animation svg .g-light-hi { fill: var(--g-light-hi); }
	.step-animation svg .g-beam { fill: var(--diagram-light); fill-opacity: 0.2; }
	.step-animation svg .g-accent { fill: var(--accent); }
	.step-animation svg .g-ink { fill: var(--diagram-stroke); }
	.step-animation svg .g-bg { fill: var(--color-bg); }
	.step-animation svg .g-sunken { fill: var(--surface-sunken); }
	.step-animation svg .g-white { fill: #fff; }
	.step-animation svg .g-ground { fill: var(--diagram-stroke); fill-opacity: 0.1; }
	.step-animation svg .g-soft { fill-opacity: 0.3; }
	.step-animation svg .g-none { fill: none; }

	.step-animation svg [class*='s-'] { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
	.step-animation svg .s-ink { stroke: var(--diagram-stroke); }
	.step-animation svg .s-muted { stroke: var(--color-text-muted); }
	.step-animation svg .s-arrow { stroke: var(--diagram-stroke); stroke-opacity: 0.6; stroke-width: 2.5; }
	.step-animation svg .s-light { stroke: var(--diagram-light); }
	.step-animation svg .s-cu { stroke: var(--diagram-copper); }
	.step-animation svg .s-ox { stroke: var(--diagram-oxide); }
	.step-animation svg .s-pr { stroke: var(--diagram-resist); }
	.step-animation svg .s-si { stroke: var(--diagram-silicon); }
	.step-animation svg .s-accent { stroke: var(--accent); }
	.step-animation svg .s-white { stroke: #fff; }
	.step-animation svg .s-bg { stroke: var(--color-bg); }
	.step-animation svg .s-thick { stroke-width: 4; }
	.step-animation svg .s-thin { stroke-width: 1.5; }
	.step-animation svg .s-6 { stroke-width: 6; }
	.step-animation svg .s-butt { stroke-linecap: butt; stroke-linejoin: miter; }
	.step-animation svg .s-dash { stroke-dasharray: 6 5; }
	.step-animation svg .s-fill-bg { fill: var(--color-bg); }
	.step-animation svg .s-fill-sunken { fill: var(--surface-sunken); }

	.step-animation svg .t { fill: var(--color-text); }
	.step-animation svg .t-muted { fill: var(--color-text-muted); }
	.step-animation svg .t-white { fill: #fff; }
	.step-animation svg .t-accent { fill: var(--accent); }
	.step-animation svg .t-bold { font-weight: 700; }

	.step-animation svg [class*='m-'] {
		animation-duration: var(--t, 3s);
		animation-delay: var(--d, 0s);
		animation-iteration-count: infinite;
		animation-timing-function: ease-in-out;
	}
	.step-animation svg .m-twinkle { animation-name: m-twinkle; }
	.step-animation svg .m-glow { animation-name: m-glow; }
	.step-animation svg .m-beam { animation-name: m-beam; }
	.step-animation svg .m-move { animation-name: m-move; animation-timing-function: linear; animation-fill-mode: backwards; }
	.step-animation svg .m-shift { animation-name: m-shift; }
	.step-animation svg .m-float { animation-name: m-float; }
	.step-animation svg .m-flow { animation-name: m-flow; animation-timing-function: linear; animation-duration: var(--t, 1s); stroke-dasharray: 7 6; }
	.step-animation svg .m-fade { animation-name: m-fade; animation-duration: var(--t, 5s); }
	.step-animation svg .m-fade-out { animation-name: m-fade-out; animation-duration: var(--t, 5s); opacity: 0; }
	.step-animation svg .m-grow-up { animation-name: m-grow-y; animation-duration: var(--t, 5s); transform-box: fill-box; transform-origin: 50% 100%; }
	.step-animation svg .m-grow-down { animation-name: m-grow-y; animation-duration: var(--t, 5s); transform-box: fill-box; transform-origin: 50% 0; }
	.step-animation svg .m-grow-right { animation-name: m-grow-x; animation-duration: var(--t, 5s); transform-box: fill-box; transform-origin: 0 50%; }
	.step-animation svg .m-shrink-down { animation-name: m-shrink-y; animation-duration: var(--t, 5s); transform-box: fill-box; transform-origin: 50% 100%; transform: scaleY(0); }
	.step-animation svg .m-pulse { animation-name: m-pulse; animation-duration: var(--t, 2s); transform-box: fill-box; transform-origin: center; }
	.step-animation svg .m-spin { animation-name: m-spin; animation-timing-function: linear; animation-duration: var(--t, 6s); transform-box: fill-box; transform-origin: center; }
	.step-animation svg .m-ping { animation-name: m-ping; animation-timing-function: ease-out; animation-duration: var(--t, 2s); transform-box: fill-box; transform-origin: center; opacity: 0; }
	.step-animation svg .m-draw { animation-name: m-draw; animation-duration: var(--t, 4s); stroke-dasharray: 1; }

	@keyframes m-twinkle { 0%, 100% { opacity: 1; } 50% { opacity: 0.3; } }
	@keyframes m-glow { 0%, 100% { filter: brightness(1); } 50% { filter: brightness(1.3); } }
	@keyframes m-beam { 0%, 100% { fill-opacity: 0.12; } 50% { fill-opacity: 0.3; } }
	@keyframes m-move {
		0% { transform: translate(0, 0); opacity: 0; }
		15%, 80% { opacity: 1; }
		100% { transform: translate(var(--dx, 0), var(--dy, 0)); opacity: 0; }
	}
	@keyframes m-shift {
		0%, 100% { transform: translate(0, 0); }
		50% { transform: translate(var(--dx, 0), var(--dy, 0)); }
	}
	@keyframes m-float { 0%, 100% { transform: translateY(3px); } 50% { transform: translateY(-3px); } }
	@keyframes m-flow { to { stroke-dashoffset: -13; } }
	@keyframes m-fade { 0%, 15% { opacity: 0; } 60%, 100% { opacity: 1; } }
	@keyframes m-fade-out { 0%, 15% { opacity: 1; } 60%, 100% { opacity: 0; } }
	@keyframes m-grow-y { 0%, 8% { transform: scaleY(0.05); } 65%, 100% { transform: scaleY(1); } }
	@keyframes m-grow-x { 0%, 8% { transform: scaleX(0.05); } 65%, 100% { transform: scaleX(1); } }
	@keyframes m-shrink-y { 0%, 10% { transform: scaleY(1); } 65%, 100% { transform: scaleY(0); } }
	@keyframes m-pulse { 0%, 100% { transform: scale(0.9); } 50% { transform: scale(1.1); } }
	@keyframes m-spin { to { transform: rotate(360deg); } }
	@keyframes m-ping { 0% { transform: scale(0.6); opacity: 0.9; } 100% { transform: scale(1.8); opacity: 0; } }
	@keyframes m-draw { 0%, 5% { stroke-dashoffset: 1; } 70%, 100% { stroke-dashoffset: 0; } }

	/* 보이지 않는 단계는 멈추고, 다시 열리면 처음부터 재생 */
	.step-animation[data-ready] .steps > :not([data-active]) svg * {
		animation: none;
	}

	@media (prefers-reduced-motion: reduce) {
		.step-animation svg * {
			animation: none !important;
		}
	}
</style>
