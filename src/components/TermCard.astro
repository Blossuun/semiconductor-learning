---
import { getEntry } from 'astro:content';

interface Props {
	id: string;
}

const { id } = Astro.props;
const entry = await getEntry('glossary', id);
if (!entry) {
	throw new Error(`TermCard: glossary.yaml에 id "${id}" 용어가 없습니다.`);
}
const term = entry.data;

const abbrs = term.abbr
	? String(term.abbr)
			.split(',')
			.map((s) => s.trim())
			.filter(Boolean)
	: [];

const rows = [
	{ name: 'English', lang: 'en', speak: 'en-US', text: term.en, reading: undefined },
	{ name: '日本語', lang: 'ja', speak: 'ja-JP', text: term.ja, reading: term.ja_reading },
	{ name: '简体中文', lang: 'zh-Hans', speak: 'zh-CN', text: term.zh_cn, reading: term.zh_cn_pinyin },
	{ name: '繁體中文', lang: 'zh-Hant', speak: 'zh-TW', text: term.zh_tw, reading: term.zh_tw_pinyin },
];
---

<article class="term-card" id={`term-${id}`}>
	<header class="head">
		<p class="ko" lang="ko">{term.ko}</p>
		<button
			class="speak"
			type="button"
			aria-label="한국어 발음 듣기"
			data-speak={term.ko}
			data-speak-lang="ko-KR"
		>
			<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
				<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
				<path
					d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
				/>
			</svg>
		</button>
		{abbrs.map((abbr) => <span class="chip mono">{abbr}</span>)}
		{term.module !== undefined && <span class="chip caption">{term.module}단계</span>}
	</header>

	<p class="definition">{term.definition_ko}</p>

	{
		term.field_usage && (
			<p class="field">
				<span class="field-label">현장 메모</span>
				{term.field_usage}
			</p>
		)
	}

	<div class="langs">
		<dl>
			{
				rows.map((row) => (
					<div class="row" data-lang={row.lang} lang={row.lang}>
						<dt>{row.name}</dt>
						<dd>
							<span class="text">
								<span class="word">{row.text}</span>
								{row.reading && <span class="reading">{row.reading}</span>}
							</span>
							<button
								class="speak"
								type="button"
								aria-label={`${row.name} 발음 듣기`}
								data-speak={row.text}
								data-speak-lang={row.speak}
							>
								<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
									<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
									<path
										d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
									/>
								</svg>
							</button>
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</article>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-speak]');

	if (!('speechSynthesis' in window)) {
		buttons.forEach((button) => (button.hidden = true));
	} else {
		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const utterance = new SpeechSynthesisUtterance(button.dataset.speak);
				utterance.lang = button.dataset.speakLang!;
				window.speechSynthesis.cancel();
				window.speechSynthesis.speak(utterance);
			});
		});
	}
</script>

<style>
	.term-card {
		margin: var(--space-4) 0;
		padding: var(--space-5);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		color: var(--text);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
	}

	.ko {
		margin: 0;
		font-family: var(--font-sans-ko);
		font-size: var(--fs-term-main);
		line-height: var(--lh-term-main);
		font-weight: 700;
	}

	.chip {
		margin: 0;
		padding: 0 var(--space-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-sunken);
		color: var(--text-muted);
	}

	.mono {
		font-family: var(--font-mono);
		font-size: var(--fs-mono);
		line-height: var(--lh-mono);
		font-weight: 500;
	}

	.caption {
		font-size: var(--fs-caption);
		line-height: var(--lh-caption);
		font-weight: 500;
	}

	.speak {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--touch-min);
		height: var(--touch-min);
		min-width: var(--touch-min);
		min-height: var(--touch-min);
		padding: 0;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-full);
		background: var(--surface);
		color: var(--primary);
		cursor: pointer;
	}

	.speak:hover {
		background: var(--primary-soft);
	}

	.definition {
		margin: var(--space-3) 0 0;
		font-size: var(--fs-body);
		line-height: var(--lh-body);
	}

	.field {
		margin: var(--space-3) 0 0;
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-md);
		background: var(--accent-soft);
		font-size: var(--fs-body);
		line-height: var(--lh-body);
	}

	.field-label {
		display: block;
		color: var(--text-muted);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
	}

	.langs {
		margin: var(--space-4) 0 0;
		padding-top: var(--space-3);
		border-top: 1px solid var(--border);
	}

	:global(html[data-learn-lang='none']) .langs {
		display: none;
	}

	dl {
		margin: 0;
	}

	.row {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr);
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) 0;
	}

	dt {
		color: var(--text-muted);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 500;
	}

	dd {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-2);
		margin: 0;
	}

	.text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.word {
		overflow-wrap: anywhere;
		font-size: var(--fs-term-sub);
		line-height: var(--lh-term-sub);
		font-weight: 500;
	}

	.row[lang='ja'] .word {
		font-family: var(--font-sans-ja);
	}

	.row[lang='zh-Hans'] .word {
		font-family: var(--font-sans-sc);
	}

	.row[lang='zh-Hant'] .word {
		font-family: var(--font-sans-tc);
	}

	.reading {
		color: var(--text-muted);
		font-size: var(--fs-reading);
		line-height: var(--lh-reading);
	}

	@media (prefers-reduced-motion: no-preference) {
		.speak {
			transition: background 0.15s ease;
		}
	}
</style>
