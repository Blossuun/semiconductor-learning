---
import { getEntry } from 'astro:content';

interface Props {
	id: string;
}

const { id } = Astro.props;
const entry = await getEntry('glossary', id);
if (!entry) {
	throw new Error(`TermCard: glossary.yaml에 id "${id}" 용어가 없습니다.`);
}
const term = entry.data;

const rows = [
	{ name: '한국어', lang: 'ko', speak: 'ko-KR', text: term.ko, reading: undefined },
	{ name: 'English', lang: 'en', speak: 'en-US', text: term.en, reading: undefined },
	{ name: '日本語', lang: 'ja', speak: 'ja-JP', text: term.ja, reading: term.ja_reading },
	{ name: '简体中文', lang: 'zh-Hans', speak: 'zh-CN', text: term.zh_cn, reading: term.zh_cn_pinyin },
	{ name: '繁體中文', lang: 'zh-Hant', speak: 'zh-TW', text: term.zh_tw, reading: term.zh_tw_pinyin },
];
---

<article class="term-card" id={`term-${id}`}>
	<dl class="langs">
		{
			rows.map((row) => (
				<div class="row">
					<dt>{row.name}</dt>
					<dd>
						<span class="word" lang={row.lang}>
							{row.text}
						</span>
						{row.reading && <span class="reading">{row.reading}</span>}
						<button
							class="speak"
							type="button"
							aria-label={`${row.name} 발음 듣기`}
							data-speak={row.text}
							data-speak-lang={row.speak}
						>
							<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
								<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
								<path
									d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
								/>
							</svg>
						</button>
					</dd>
				</div>
			))
		}
	</dl>
	<p class="definition">{term.definition_ko}</p>
	{
		(term.abbr || term.field_usage) && (
			<p class="extra">
				{term.abbr && <span>약어: {term.abbr}</span>}
				{term.field_usage && <span>{term.field_usage}</span>}
			</p>
		)
	}
</article>

<script>
	const buttons = document.querySelectorAll<HTMLButtonElement>('[data-speak]');

	if (!('speechSynthesis' in window)) {
		buttons.forEach((button) => (button.hidden = true));
	} else {
		buttons.forEach((button) => {
			button.addEventListener('click', () => {
				const utterance = new SpeechSynthesisUtterance(button.dataset.speak);
				utterance.lang = button.dataset.speakLang!;
				window.speechSynthesis.cancel();
				window.speechSynthesis.speak(utterance);
			});
		});
	}
</script>

<style>
	.term-card {
		margin: var(--space-4) 0;
		padding: var(--space-3) var(--space-4);
		border: 1px solid var(--color-border);
		border-left: 4px solid var(--color-accent);
		border-radius: var(--radius);
		background: var(--color-surface);
	}

	.langs {
		margin: 0;
	}

	.row {
		display: grid;
		grid-template-columns: 5.5rem minmax(0, 1fr);
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) 0;
	}

	dt {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	dd {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
		margin: 0;
	}

	.word {
		font-size: var(--text-lg);
		font-weight: 700;
	}

	.reading {
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}

	.speak {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.75rem;
		height: 1.75rem;
		padding: 0;
		border: 1px solid var(--color-border);
		border-radius: 50%;
		background: var(--color-bg);
		color: var(--color-accent);
		cursor: pointer;
	}

	.speak:hover {
		border-color: var(--color-accent);
	}

	.definition {
		margin: var(--space-3) 0 0;
		padding-top: var(--space-3);
		border-top: 1px solid var(--color-border);
	}

	.extra {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-1) var(--space-3);
		margin: var(--space-2) 0 0;
		color: var(--color-text-muted);
		font-size: var(--text-sm);
	}
</style>
