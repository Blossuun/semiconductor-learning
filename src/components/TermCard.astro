---
import { getEntry } from 'astro:content';
import { audioPath } from '../scripts/audio-path';

interface Props {
	id: string;
	/** false면 용어집 링크를 그리지 않는다(용어집 페이지 안에서 사용). */
	glossaryLink?: boolean;
}

const { id, glossaryLink = true } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entry = await getEntry('glossary', id);
if (!entry) {
	throw new Error(`TermCard: glossary.yaml에 id "${id}" 용어가 없습니다.`);
}
const term = entry.data;

const abbrs = term.abbr
	? String(term.abbr)
			.split(',')
			.map((s) => s.trim())
			.filter(Boolean)
	: [];

// 현장에서 약어로 부르는 용어(HBM, MOSFET, FinFET 등)는 약어를 표제어로, 한국어 이름을 부제로 쓴다.
const headAbbr = abbrs.find((a) => /^[A-Z][A-Za-z0-9]{2,}$/.test(a) && (a.match(/[A-Z]/g) ?? []).length >= 2);
// 용어집 안에서는 표제어 줄이 가려지므로 약어 칩을 그대로 둔다.
const chipAbbrs = glossaryLink ? abbrs.filter((a) => a !== headAbbr) : abbrs;

const rows = [
	{ name: 'English', lang: 'en', speak: 'en-US', text: term.en, reading: undefined, example: term.example_en, audio: audioPath('terms', id, 'en'), exampleAudio: audioPath('terms', id, 'example_en') },
	{ name: '日本語', lang: 'ja', speak: 'ja-JP', text: term.ja, reading: term.ja_reading, example: term.example_ja, audio: audioPath('terms', id, 'ja'), exampleAudio: audioPath('terms', id, 'example_ja') },
	{ name: '简体中文', lang: 'zh-Hans', speak: 'zh-CN', text: term.zh_cn, reading: term.zh_cn_pinyin, example: term.example_zh_cn, audio: audioPath('terms', id, 'zh_cn'), exampleAudio: audioPath('terms', id, 'example_zh_cn') },
	{ name: '繁體中文', lang: 'zh-Hant', speak: 'zh-TW', text: term.zh_tw, reading: term.zh_tw_pinyin, example: term.example_zh_tw, audio: audioPath('terms', id, 'zh_tw'), exampleAudio: audioPath('terms', id, 'example_zh_tw') },
];
const koAudio = audioPath('terms', id, 'ko');
const koExampleAudio = audioPath('terms', id, 'example_ko');
// 레슨(glossaryLink=true)에서는 한 줄 목록으로 접어 두고, 누르면 펼친다. 용어집은 바깥 details가 이미 접으므로 그대로 둔다.
const Wrap = glossaryLink ? 'details' : 'div';
---

<Wrap class={glossaryLink ? 'term-fold' : 'term-plain'}>
	{
		glossaryLink && (
			<summary class="fold-row">
				<span class="fold-ko">
					{headAbbr ?? term.ko}
					{headAbbr && <span class="fold-sub">{term.ko}</span>}
				</span>
				<span class="fold-foreign">
					{term.en && <span data-lang="en" lang="en">{term.en}</span>}
					{term.ja && <span data-lang="ja" lang="ja">{term.ja}</span>}
					{term.zh_cn && <span data-lang="zh-Hans" lang="zh-Hans">{term.zh_cn}</span>}
					{term.zh_tw && <span data-lang="zh-Hant" lang="zh-Hant">{term.zh_tw}</span>}
				</span>
				{!term.verified && <span class="fold-badge unverified">확인 전</span>}
				{term.module !== undefined && <span class="fold-badge">{term.module}단계</span>}
			</summary>
		)
	}
	<article class="term-card" id={`term-${id}`}>
	<header class="head">
		{
			headAbbr ? (
				<p class="ko" lang="ko">
					<span lang="en">{headAbbr}</span>
					<span class="sub">{term.ko}</span>
				</p>
			) : (
				<p class="ko" lang="ko">{term.ko}</p>
			)
		}
		<button
			class="speak"
			type="button"
			aria-label="한국어 발음 듣기"
			data-speak={term.ko}
			data-speak-lang="ko-KR"
			data-audio={koAudio}
		>
			<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
				<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
				<path
					d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
				/>
			</svg>
		</button>
		{chipAbbrs.map((abbr) => <span class="chip mono">{abbr}</span>)}
		{term.module !== undefined && <span class="chip caption">{term.module}단계</span>}
			{glossaryLink && (
				<a class="glossary-link" href={`${base}/glossary/#term-${id}`}>용어집에서 보기</a>
			)}
	</header>

	<p class="definition">{term.definition_ko}</p>

	{
		term.example_ko && (
			<p class="example-ko" lang="ko">
				<span>{term.example_ko}</span>
				<button
					class="speak speak-sm"
					type="button"
					aria-label="한국어 예문 듣기"
					data-speak={term.example_ko}
					data-speak-lang="ko-KR"
					data-audio={koExampleAudio}
				>
					<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
					<path d="M16.5 8.5a5 5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
				</button>
			</p>
		)
	}

	{
		term.field_usage && (
			<p class="field">
				<span class="field-label">현장 메모</span>
				{term.field_usage}
			</p>
		)
	}

	<div class="langs">
		<dl>
			{
				rows.map((row) => (
					<div class="row" data-lang={row.lang} lang={row.lang}>
						<dt>{row.name}</dt>
						<dd>
							<span class="text">
								<span class="word">{row.text}</span>
								{row.reading && <span class="reading">{row.reading}</span>}
							</span>
							<button
								class="speak"
								type="button"
								aria-label={`${row.name} 발음 듣기`}
								data-speak={row.text}
								data-speak-lang={row.speak}
								data-audio={row.audio}
							>
								<svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
									<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
									<path
										d="M16.5 8.5a5 5 0 0 1 0 7M19 6a8.5 8.5 0 0 1 0 12"
										fill="none"
										stroke="currentColor"
										stroke-width="2"
										stroke-linecap="round"
									/>
								</svg>
							</button>
							{row.example && <span class="example">{row.example}</span>}
							{row.example && (
								<button
									class="speak speak-sm"
									type="button"
									aria-label={`${row.name} 예문 듣기`}
									data-speak={row.example}
									data-speak-lang={row.speak}
									data-audio={row.exampleAudio}
								>
									<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path d="M4 9v6h4l5 4V5L8 9H4z" fill="currentColor" />
					<path d="M16.5 8.5a5 5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
				</svg>
								</button>
							)}
						</dd>
					</div>
				))
			}
		</dl>
	</div>
</article>
	</Wrap>

<script>
	import '../scripts/speak.ts';
</script>

<style>
	.term-card {
		margin: var(--space-4) 0;
		padding: var(--space-5);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
		color: var(--text);
	}

	.head {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-2);
	}

	.ko {
		margin: 0;
		font-family: var(--font-sans-ko);
		font-size: var(--fs-term-main);
		line-height: var(--lh-term-main);
		font-weight: 700;
	}

	.sub {
		margin-left: var(--space-2);
		color: var(--text-muted);
		font-size: var(--fs-small);
		font-weight: 500;
	}

	.chip {
		margin: 0;
		padding: 0 var(--space-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		background: var(--surface-sunken);
		color: var(--text-muted);
	}

	.mono {
		font-family: var(--font-mono);
		font-size: var(--fs-mono);
		line-height: var(--lh-mono);
		font-weight: 500;
	}

	.caption {
		font-size: var(--fs-caption);
		line-height: var(--lh-caption);
		font-weight: 500;
	}

	.glossary-link {
		display: inline-flex;
		align-items: center;
		min-height: var(--touch-min);
		margin-left: auto;
		padding: 0 var(--space-2);
		border-radius: var(--radius-sm);
		color: var(--primary);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	.glossary-link:hover {
		background: var(--primary-soft);
	}

	.speak {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: var(--touch-min);
		height: var(--touch-min);
		min-width: var(--touch-min);
		min-height: var(--touch-min);
		padding: 0;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-full);
		background: var(--surface);
		color: var(--primary);
		cursor: pointer;
	}

	.speak[hidden] {
		display: none;
	}

	.speak-sm {
		border-color: transparent;
		color: var(--text-muted);
	}

	.speak:hover {
		background: var(--primary-soft);
	}

	.definition {
		margin: var(--space-3) 0 0;
		font-size: var(--fs-body);
		line-height: var(--lh-body);
	}

	.example-ko {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin: var(--space-2) 0 0;
		color: var(--text-muted);
		font-family: var(--font-sans-ko);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
	}

	.field {
		margin: var(--space-3) 0 0;
		padding: var(--space-3) var(--space-4);
		border-radius: var(--radius-md);
		background: var(--accent-soft);
		font-size: var(--fs-body);
		line-height: var(--lh-body);
	}

	.field-label {
		display: block;
		color: var(--text-muted);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
	}

	.langs {
		margin: var(--space-4) 0 0;
		padding-top: var(--space-3);
		border-top: 1px solid var(--border);
	}

	:global(html[data-learn-lang='none']) .langs {
		display: none;
	}

	dl {
		margin: 0;
	}

	.row {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr);
		align-items: center;
		gap: var(--space-2);
		padding: var(--space-1) 0;
	}

	dt {
		color: var(--text-muted);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 500;
	}

	dd {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: center;
		gap: var(--space-2);
		margin: 0;
	}

	.text {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.word {
		overflow-wrap: anywhere;
		font-size: var(--fs-term-sub);
		line-height: var(--lh-term-sub);
		font-weight: 500;
	}

	.example {
		color: var(--text-muted);
		overflow-wrap: anywhere;
		font-size: var(--fs-small);
		line-height: var(--lh-small);
	}

	.row[lang='ja'] .word,
	.row[lang='ja'] .example {
		font-family: var(--font-sans-ja);
	}

	.row[lang='zh-Hans'] .word,
	.row[lang='zh-Hans'] .example {
		font-family: var(--font-sans-sc);
	}

	.row[lang='zh-Hant'] .word,
	.row[lang='zh-Hant'] .example {
		font-family: var(--font-sans-tc);
	}

	.reading {
		color: var(--text-muted);
		font-size: var(--fs-reading);
		line-height: var(--lh-reading);
	}

	.row[data-no-voice] .reading {
		align-self: flex-start;
		padding: 0 var(--space-1);
		border-radius: var(--radius-sm);
		background: var(--primary-soft);
		color: var(--text);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 600;
	}

	.term-fold {
		margin: var(--space-4) 0;
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: var(--surface);
	}

	.term-fold[open] {
		border-color: var(--primary);
	}

	/* 접힌 행이 표제·단계를 이미 보여 주므로 펼친 카드에서는 같은 정보를 시각적으로 숨긴다 */
	.term-fold > .term-card {
		margin: 0;
		padding: 0 var(--space-4) var(--space-4);
		border: 0;
		background: none;
	}

	.term-fold > .term-card .ko,
	.term-fold > .term-card .chip.caption {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
		white-space: nowrap;
	}

	.fold-row {
		display: flex;
		align-items: center;
		gap: var(--space-3);
		min-height: 56px;
		padding: 0 var(--space-4);
		cursor: pointer;
		list-style: none;
	}

	.fold-row::-webkit-details-marker {
		display: none;
	}

	.fold-row:focus-visible {
		outline: 2px solid var(--focus);
		outline-offset: 2px;
		border-radius: var(--radius-lg);
	}

	.fold-ko {
		flex: none;
		font-family: var(--font-sans-ko);
		font-size: var(--fs-body);
		line-height: var(--lh-body);
		font-weight: 700;
	}

	.fold-sub {
		margin-inline-start: var(--space-2);
		color: var(--text-muted);
		font-size: var(--fs-small);
		font-weight: 500;
	}

	.fold-foreign {
		flex: 1 1 auto;
		min-width: 0;
		overflow: hidden;
		color: var(--text-muted);
		font-size: var(--fs-small);
		line-height: var(--lh-small);
		font-weight: 500;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.fold-foreign > span {
		margin-inline-end: var(--space-3);
	}

	.fold-badge {
		flex: none;
		padding: 0 var(--space-2);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: var(--fs-caption);
		line-height: var(--lh-caption);
		font-weight: 500;
	}

	.fold-badge.unverified {
		color: var(--text-muted);
	}

	@media (prefers-reduced-motion: no-preference) {
		.speak {
			transition: background 0.15s ease;
		}
	}
</style>
